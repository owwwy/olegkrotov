---
import '@fontsource-variable/onest';
import ClientRouting from '../components/ClientRouting.astro';
import MobileTapScramble from '../components/MobileTapScramble.astro';
import SiteSidebar from '../components/SiteSidebar.astro';
import TypeScale from '../components/TypeScale.astro';
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<ClientRouting />
		<style is:inline>
			html,body{margin:0;background:#fff}
			@media(max-width:767px){[data-info-preloader]{display:none!important}}
		</style>
		<script is:inline data-astro-rerun>
			var internalInfoTransition = false;
			var mobileInfoLayout = window.matchMedia('(max-width: 767px)').matches;
			document.documentElement.classList.toggle('mobile-layout', mobileInfoLayout);
			try {
				internalInfoTransition = sessionStorage.getItem('info-page-transition') === 'true';
				sessionStorage.removeItem('info-page-transition');
			} catch {}
			document.documentElement.classList.remove(
				'is-preloading', 'is-revealing', 'is-identity-ready', 'info-return-home', 'info-return-ready'
			);
			if (!internalInfoTransition && !mobileInfoLayout) document.documentElement.classList.add('info-direct-preloading');
			document.documentElement.classList.add('info-entering');
			window.addEventListener('pageshow', (event) => {
				if (event.persisted) window.location.reload();
			});
		</script>
		<TypeScale />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#ffffff" data-site-theme-color />
		<meta name="description" content="Олег Кротов — digital designer. Проектирую интерфейсы и развиваю дизайн-системы." />
		<title>Инфо — Олег Кротов</title>
	</head>
	<body>
		<MobileTapScramble />
		<div class="info-preloader" data-info-preloader aria-live="polite">
			<div class="info-preloader__identity" data-info-preloader-identity>
				<strong data-info-preloader-name></strong>
				<span data-info-preloader-role></span>
			</div>
		</div>
		<div class="page-grid">
			<SiteSidebar active="info" />
			<main>
				<div class="info-copy">
					<p>
						<span class="info-line">
							<strong>Проектирую интерфейсы</strong>
							<span class="visual visual--01" aria-hidden="true"><img src="/info/01.png" alt="" /></span>
							<span>цифровых</span>
						</span>
						<span class="info-line">
							<span>продуктов и</span>
							<span class="visual visual--02" aria-hidden="true"><img src="/info/02.png" alt="" /></span>
							<span><strong>развиваю дизайн-системы</strong>.</span>
						</span>
					</p>
					<p>
						<span class="info-line"><span>Для меня хорошие продукты —</span></span>
						<span class="info-line">
							<span>это баланс</span>
							<span class="visual visual--long" aria-hidden="true"><img src="/info/03.png" alt="" /></span>
							<span>между экспертизой,</span>
						</span>
						<span class="info-line">
							<span>эстетикой и простыми</span>
							<span class="visual visual--wide visual--overflow" aria-hidden="true"><img src="/info/04.png" alt="" /></span>
							<span>исследованиями.</span>
						</span>
					</p>
					<p>
						<span class="info-line"><span>Я глубоко ценю визуальную</span></span>
						<span class="info-line"><span>выразительность в цифровых продуктах,</span></span>
						<span class="info-line">
							<span>но считаю, что она <strong>должна</strong></span>
							<span class="visual visual--square visual--zoom" aria-hidden="true"><img src="/info/05.png" alt="" /></span>
							<span><strong>работать</strong></span>
						</span>
						<span class="info-line"><strong>в пользу понятности и интуитивности.</strong></span>
					</p>
				</div>
			</main>
		</div>
		<script is:inline data-astro-rerun>
			(() => {
				const loader = document.querySelector('[data-info-preloader]');
				if (!document.documentElement.classList.contains('info-direct-preloading')) {
					loader?.remove();
					return;
				}
				const identity = document.querySelector('[data-info-preloader-identity]');
				const nameElement = document.querySelector('[data-info-preloader-name]');
				const roleElement = document.querySelector('[data-info-preloader-role]');
				const targetIdentity = document.querySelector('.identity');
				if (!loader || !identity || !nameElement || !roleElement || !targetIdentity) return;
				const values = ['Олег Кротов', 'Digital Designer'];
				const elements = [nameElement, roleElement];
				const pools = values.map((value) => [...new Set([...value].filter((character) => character !== ' '))]);
				const visible = [0, 0];
				const settled = [0, 0];
				const draw = (element, characters) => {
					element.textContent = characters.map((character) => character === ' ' ? '\u00a0' : character).join('');
				};
				values.forEach((value, index) => draw(elements[index], [...value]));
				const bounds = identity.getBoundingClientRect();
				identity.style.width = `${bounds.width}px`;
				identity.style.height = `${bounds.height}px`;
				elements.forEach((element) => draw(element, []));
				const scrambleTimer = window.setInterval(() => {
					values.forEach((value, valueIndex) => {
						const output = [...value].map((character, index) => {
							if (index >= visible[valueIndex]) return '';
							if (character === ' ' || index < settled[valueIndex]) return character;
							const pool = pools[valueIndex];
							return pool[Math.floor(Math.random() * pool.length)] ?? character;
						});
						draw(elements[valueIndex], output);
					});
				}, 58);
				const build = (valueIndex, duration, delay = 0) => new Promise((resolve) => {
					const startedAt = performance.now() + delay;
					const length = [...values[valueIndex]].length;
					const frame = (now) => {
						if (now < startedAt) {
							requestAnimationFrame(frame);
							return;
						}
						const progress = Math.min(1, (now - startedAt) / duration);
						visible[valueIndex] = Math.ceil(Math.min(1, progress / .68) * length);
						const settling = Math.max(0, (progress - .68) / .32);
						settled[valueIndex] = Math.floor((1 - Math.pow(1 - settling, 2)) * length);
						if (progress < 1) requestAnimationFrame(frame);
						else resolve();
					};
					requestAnimationFrame(frame);
				});
				(async () => {
					await Promise.all([build(0, 680), build(1, 760, 90), document.fonts?.ready ?? Promise.resolve()]);
					window.clearInterval(scrambleTimer);
					values.forEach((value, index) => draw(elements[index], [...value]));
					await new Promise((resolve) => window.setTimeout(resolve, 320));
					const target = targetIdentity.getBoundingClientRect();
					const source = identity.getBoundingClientRect();
					identity.style.setProperty('--info-loader-x', `${target.left - source.left}px`);
					identity.style.setProperty('--info-loader-y', `${target.top - source.top}px`);
					loader.classList.add('is-returning');
					identity.classList.add('is-returning');
					window.setTimeout(() => {
						document.documentElement.classList.add('info-direct-revealing');
						window.dispatchEvent(new CustomEvent('info:direct-reveal'));
					}, 260);
					window.setTimeout(() => document.documentElement.classList.add('info-direct-identity-ready'), 610);
					window.setTimeout(() => {
						document.documentElement.classList.remove(
							'info-direct-preloading', 'info-direct-identity-ready', 'info-direct-revealing'
						);
						loader.remove();
					}, 760);
				})();
			})();
		</script>
		<script>
			import { navigate } from 'astro:transitions/client';

			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			let isReturningHome = false;
			let cleanupInfoPage = () => {};
			const initializeInfoPage = () => {
				cleanupInfoPage();
				const controller = new AbortController();
				const copy = document.querySelector<HTMLElement>('.info-copy');
				if (!copy) return;
				document.documentElement.classList.add('info-entering');
				const textNodes: Text[] = [];
				const walker = document.createTreeWalker(copy, NodeFilter.SHOW_TEXT);
				let node = walker.nextNode();
				while (node) {
					if (node.textContent?.trim()) textNodes.push(node as Text);
					node = walker.nextNode();
				}
				textNodes.forEach((textNode) => {
					const fragment = document.createDocumentFragment();
					[...(textNode.textContent ?? '')].forEach((character) => {
						const span = document.createElement('span');
						span.className = character === ' ' ? 'info-char info-char--space' : 'info-char';
						span.dataset.character = character;
						span.textContent = character === ' ' ? '\u00a0' : character;
						fragment.append(span);
					});
					textNode.replaceWith(fragment);
				});

				const characters = [...copy.querySelectorAll<HTMLElement>('.info-char:not(.info-char--space)')];
				const spaces = [...copy.querySelectorAll<HTMLElement>('.info-char--space')];
				const visuals = [...copy.querySelectorAll<HTMLElement>('.visual')];
				const characterPool = [...new Set(characters.map((character) => character.dataset.character ?? '').filter(Boolean))];
				const scramblePools = new WeakMap<HTMLElement, string[]>();
				const measurementCanvas = document.createElement('canvas');
				const measurementContext = measurementCanvas.getContext('2d');
				const randomCharacter = (element: HTMLElement) => {
					let pool = scramblePools.get(element);
					if (!pool) {
						const styles = getComputedStyle(element);
						const targetWidth = element.getBoundingClientRect().width;
						if (measurementContext) {
							measurementContext.font = `${styles.fontStyle} ${styles.fontWeight} ${styles.fontSize} ${styles.fontFamily}`;
							pool = characterPool.filter((character) => {
								const width = measurementContext.measureText(character).width;
								return width <= targetWidth + 0.5 && width >= targetWidth * 0.42;
							});
						}
						pool = pool?.length ? pool : [element.dataset.character ?? ''];
						scramblePools.set(element, pool);
					}
					return pool[Math.floor(Math.random() * pool.length)] ?? '';
				};
				const enterSpeed = 1.4;
				const characterSlots = [...characters, ...spaces];
				characterSlots.forEach((character) => {
					character.dataset.slotWidth = character.getBoundingClientRect().width.toString();
					character.dataset.slotFontSize = parseFloat(getComputedStyle(character).fontSize).toString();
				});
				const updateCharacterSlots = () => {
					if (!copy.isConnected) return;
					characterSlots.forEach((character) => {
						const baseWidth = Number(character.dataset.slotWidth) || 0;
						const baseFontSize = Number(character.dataset.slotFontSize) || 1;
						const fontSize = parseFloat(getComputedStyle(character).fontSize);
						character.style.width = `${baseWidth * fontSize / baseFontSize}px`;
					});
				};
				updateCharacterSlots();
				let slotResizeFrame = 0;
				window.addEventListener('resize', () => {
					window.cancelAnimationFrame(slotResizeFrame);
					slotResizeFrame = window.requestAnimationFrame(updateCharacterSlots);
				}, { passive: true, signal: controller.signal });
				characters.forEach((character) => { character.style.opacity = '0'; });
				visuals.forEach((visual) => { visual.style.opacity = '0'; });
				document.documentElement.classList.add('info-ready');

				const pixelate = async (visual: HTMLElement, reverse = false) => {
					const image = visual.querySelector<HTMLImageElement>('img');
					if (!image) return;
					if (!image.complete) await new Promise<void>((resolve) => {
						image.addEventListener('load', () => resolve(), { once: true });
						image.addEventListener('error', () => resolve(), { once: true });
					});
					if (!image.naturalWidth) return;
					try { await image.decode(); } catch {}
					visual.style.opacity = '1';
					const canvas = document.createElement('canvas');
					const isOverflow = visual.classList.contains('visual--overflow');
					const isZoomed = visual.classList.contains('visual--zoom');
					canvas.className = `info-pixel-canvas${isOverflow ? ' info-pixel-canvas--overflow' : ''}${isZoomed ? ' info-pixel-canvas--zoom' : ''}`;
					const width = Math.max(1, Math.round(visual.clientWidth * (isOverflow ? .99 : isZoomed ? 1.5 : 1)));
					const height = Math.max(1, Math.round(visual.clientHeight * (isOverflow ? 1.368 : isZoomed ? 1.5 : 1)));
					canvas.width = width;
					canvas.height = height;
					visual.append(canvas);
					const context = canvas.getContext('2d');
					const buffer = document.createElement('canvas');
					const bufferContext = buffer.getContext('2d');
					if (!context || !bufferContext) return;
					image.style.opacity = reverse ? '1' : '0';
					const duration = reverse ? 360 : 620 / enterSpeed;
					const startedAt = performance.now();
					await new Promise<void>((resolve) => {
						const frame = (now: number) => {
							const progress = Math.min(1, (now - startedAt) / duration);
							const eased = progress * progress * (3 - 2 * progress);
							const resolution = reverse ? 1 - eased : eased;
							const pixelWidth = Math.max(3, Math.round(3 + (width - 3) * resolution));
							const pixelHeight = Math.max(1, Math.round(pixelWidth * height / width));
							buffer.width = pixelWidth;
							buffer.height = pixelHeight;
							bufferContext.imageSmoothingEnabled = true;
							bufferContext.drawImage(image, 0, 0, pixelWidth, pixelHeight);
							context.imageSmoothingEnabled = false;
							context.clearRect(0, 0, width, height);
							context.drawImage(buffer, 0, 0, pixelWidth, pixelHeight, 0, 0, width, height);
							if (reverse) {
								context.fillStyle = `rgb(255 255 255 / ${Math.max(0, (progress - .58) / .42)})`;
								context.fillRect(0, 0, width, height);
							}
							if (progress < 1) requestAnimationFrame(frame);
							else resolve();
						};
						requestAnimationFrame(frame);
					});
					image.style.opacity = reverse ? '0' : '1';
					canvas.remove();
					if (reverse) visual.style.opacity = '0';
				};

				const orderedItems = [...copy.querySelectorAll<HTMLElement>('.info-char:not(.info-char--space), .visual')];
				const enter = () => {
					if (reducedMotion.matches) {
						characters.forEach((character) => { character.style.opacity = '1'; });
						visuals.forEach((visual) => { visual.style.opacity = '1'; });
						return;
					}
					let position = 0;
					orderedItems.forEach((item) => {
						const delay = (position * 8 + Math.random() * 90) / enterSpeed;
						if (item.classList.contains('visual')) {
							window.setTimeout(() => { void pixelate(item); }, delay);
							position += 5;
							return;
						}
						const target = item.dataset.character ?? '';
						const duration = (300 + Math.random() * 380) / enterSpeed;
						window.setTimeout(() => {
							item.style.opacity = '1';
							const startedAt = performance.now();
							let lastTick = 0;
							const frame = (now: number) => {
								const progress = Math.min(1, (now - startedAt) / duration);
								if (now - lastTick >= 42 || progress === 1) {
									lastTick = now;
									item.textContent = progress === 1 ? target : randomCharacter(item);
								}
								if (progress < 1) requestAnimationFrame(frame);
							};
							requestAnimationFrame(frame);
						}, delay);
						position += 1;
					});
				};

				let isLeaving = false;
				const leave = () => new Promise<void>((resolve) => {
					if (isLeaving) return;
					isLeaving = true;
					const reversed = [...orderedItems].reverse();
					let finished = 0;
					const complete = () => {
						finished += 1;
						if (finished === reversed.length) resolve();
					};
					reversed.forEach((item, index) => {
						const delay = index * 5 + Math.random() * 44;
						window.setTimeout(() => {
							if (item.classList.contains('visual')) {
								void pixelate(item, true).then(complete);
								return;
							}
							const duration = 180 + Math.random() * 180;
							const startedAt = performance.now();
							let lastTick = 0;
							const frame = (now: number) => {
								const progress = Math.min(1, (now - startedAt) / duration);
								if (now - lastTick >= 36 || progress === 1) {
									lastTick = now;
									item.textContent = progress === 1 ? '' : randomCharacter(item);
									item.style.opacity = `${1 - Math.max(0, (progress - .55) / .45)}`;
								}
								if (progress < 1) requestAnimationFrame(frame);
								else complete();
							};
							requestAnimationFrame(frame);
						}, delay);
					});
				});

				if (document.documentElement.classList.contains('info-direct-preloading')) {
					window.addEventListener('info:direct-reveal', enter, { once: true });
				} else requestAnimationFrame(enter);
				document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
					const destination = new URL(link.href, window.location.href);
					if (destination.origin !== window.location.origin || destination.pathname === '/info') return;
					link.addEventListener('click', async (event) => {
						event.preventDefault();
						if (reducedMotion.matches) {
							if (destination.pathname === '/') {
								isReturningHome = true;
								try { sessionStorage.setItem('info-return-home', 'true'); } catch {}
								destination.searchParams.set('info-return', Date.now().toString());
							}
							void navigate(destination.href);
						}
						else {
							await leave();
							if (destination.pathname === '/') {
								isReturningHome = true;
								try { sessionStorage.setItem('info-return-home', 'true'); } catch {}
								destination.searchParams.set('info-return', Date.now().toString());
							}
							void navigate(destination.href);
						}
					}, { signal: controller.signal });
				});
				cleanupInfoPage = () => {
					controller.abort();
					document.documentElement.classList.remove('info-entering', 'info-ready');
				};
			};
			document.addEventListener('astro:page-load', initializeInfoPage);
			document.addEventListener('astro:before-swap', (event) => {
				if (isReturningHome) {
					const swapEvent = event as Event & { newDocument?: Document };
					const incomingDocument = swapEvent.newDocument;
					if (incomingDocument) {
						incomingDocument.documentElement.classList.remove('is-preloading');
						incomingDocument.documentElement.classList.add('info-return-home');
						incomingDocument.querySelector('[data-site-preloader]')?.remove();
					}
				}
				cleanupInfoPage();
			});
		</script>
	</body>
</html>

<style is:global>
	.info-preloader {
		position: fixed;
		z-index: 1000;
		inset: 0;
		display: grid;
		place-items: center;
		background: #fff;
		transition: background-color 500ms cubic-bezier(.22, 1, .36, 1);
	}

	.info-preloader.is-returning {
		background: rgb(255 255 255 / 0%);
		pointer-events: none;
	}

	.info-preloader__identity {
		display: flex;
		flex-direction: column;
		transform: translate3d(0, 0, 0);
		transform-origin: top left;
		transition: transform 640ms cubic-bezier(.22, 1, .36, 1);
	}

	.info-preloader__identity.is-returning {
		transform: translate3d(var(--info-loader-x), var(--info-loader-y), 0) scale(.5);
	}

	.info-preloader__identity strong {
		font-size: calc(var(--ui-font-size) * 2);
		font-weight: 400;
		line-height: calc(var(--ui-line-height) * 2);
	}

	.info-preloader__identity span {
		color: rgb(25 25 28 / 60%);
		font-size: calc(var(--role-font-size) * 2);
		font-weight: 300;
		line-height: calc(var(--ui-line-height) * 2);
	}

	.info-direct-preloading .identity,
	.info-direct-preloading nav,
	.info-direct-preloading main {
		opacity: 0;
	}

	.identity,
	nav,
	main {
		transition: opacity 420ms ease-out;
	}

	.info-direct-preloading.info-direct-revealing nav,
	.info-direct-preloading.info-direct-revealing main,
	.info-direct-preloading.info-direct-identity-ready .identity {
		opacity: 1;
	}

	:root {
		--page-padding: 40px;
		--grid-gap: 20px;
		--color-text: #19191c;
		--color-muted: rgb(25 25 28 / 56%);
		--ui-font-size: 20px;
		--ui-line-height: 24px;
		--role-font-size: 16px;
		--info-font-size: 48px;
		--info-line-height: 58px;
		--info-inline-gap: 12px;
		--info-paragraph-gap: 48px;
		--info-chip-width: 120px;
		--info-chip-long-width: 156px;
		--info-chip-height: 58px;
	}

	*, *::before, *::after { box-sizing: border-box; }

	html {
		min-width: 1140px;
		height: 100%;
		overflow: hidden;
		background: #fff;
	}

	body {
		height: 100%;
		margin: 0;
		overflow: hidden;
		color: var(--color-text);
		background: #fff;
		font-family: 'Onest Variable', Onest, sans-serif;
		font-synthesis: none;
	}

	a { color: inherit; text-decoration: none; }

	.page-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--grid-gap);
		padding-inline: var(--page-padding);
	}

	main {
		position: relative;
		display: grid;
		grid-column: 4 / span 9;
		grid-template-columns: repeat(9, minmax(0, 1fr));
		column-gap: var(--grid-gap);
		align-content: center;
		height: 100svh;
		min-width: 0;
	}

	.info-copy {
		display: flex;
		grid-column: 1 / span 8;
		flex-direction: column;
		gap: var(--info-paragraph-gap);
		color: var(--color-muted);
		font-size: var(--info-font-size);
		font-weight: 400;
		line-height: var(--info-line-height);
		letter-spacing: 0;
	}

	.info-copy p {
		display: flex;
		margin: 0;
		flex-direction: column;
	}

	.info-line {
		display: flex;
		align-items: center;
		gap: var(--info-inline-gap);
		white-space: nowrap;
	}

	.info-line:has(> :only-child) { gap: 0; }
	.info-line > :not(.visual) {
		position: relative;
		z-index: 3;
	}
	.info-copy strong { color: var(--color-text); font-weight: inherit; }
	.info-char { display: inline-block; }
	.info-char--space { flex: none; }
	.info-entering:not(.info-ready) .info-copy { visibility: hidden; }
	.info-entering .visual { opacity: 0; }

	.visual {
		position: relative;
		z-index: 1;
		display: inline-block;
		width: var(--info-chip-width);
		height: var(--info-chip-height);
		flex: none;
		overflow: hidden;
		border-radius: 3px;
	}

	.visual--wide { width: var(--info-chip-width); }
	.visual--01 { width: calc(var(--info-chip-height) * 100 / 58); }
	.visual--02 { width: calc(var(--info-chip-height) * 103 / 58); }
	.visual--long { width: var(--info-chip-long-width); }
	.visual--square { width: var(--info-chip-height); }
	.visual img { width: 100%; height: 100%; object-fit: cover; }
	.visual--zoom img {
		transform: scale(1.5);
		transform-origin: center;
	}
	.visual--zoom { overflow: visible; }
