---
import '@fontsource-variable/onest';
import SiteSidebar from '../components/SiteSidebar.astro';
import TypeScale from '../components/TypeScale.astro';
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<style is:inline>html,body{margin:0;background:#fff}</style>
		<TypeScale />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Олег Кротов — digital designer. Проектирую интерфейсы и развиваю дизайн-системы." />
		<title>Инфо — Олег Кротов</title>
	</head>
	<body>
		<div class="page-grid">
			<SiteSidebar active="info" />
			<main>
				<div class="info-copy">
					<p>
						<strong>Проектирую интерфейсы</strong>
						<span class="visual visual--wide"><img src="/projects/upravlead.webp" alt="" /></span>
						цифровых продуктов и
						<span class="visual visual--wide"><img src="/projects/jetsite.webp" alt="" /></span>
						<strong>развиваю дизайн-системы</strong>.
					</p>
					<p>
						Для меня хорошие продукты — это баланс
						<span class="visual visual--long"><img src="/projects/podryado.webp" alt="" /></span>
						между экспертизой, эстетикой и простыми исследованиями
						<span class="visual visual--wide"><img src="/projects/s-industrial.webp" alt="" /></span>.
					</p>
					<p>
						Я глубоко ценю визуальную выразительность в цифровых продуктах, но считаю, что она
						<strong>должна работать</strong>
						<span class="visual visual--square"><img src="/projects/addinol.webp" alt="" /></span>
						<strong>в пользу понятности и интуитивности.</strong>
					</p>
				</div>
				<span class="info-marker" aria-hidden="true"></span>
			</main>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--page-padding: 40px;
		--grid-gap: 20px;
		--color-text: #19191c;
		--color-muted: rgb(25 25 28 / 56%);
		--ui-font-size: 20px;
		--ui-line-height: 24px;
		--role-font-size: 16px;
		--info-font-size: 48px;
		--info-line-height: 58px;
	}

	*, *::before, *::after { box-sizing: border-box; }

	html {
		min-width: 1140px;
		height: 100%;
		overflow: hidden;
		background: #fff;
	}

	body {
		height: 100%;
		margin: 0;
		overflow: hidden;
		color: var(--color-text);
		background: #fff;
		font-family: 'Onest Variable', Onest, sans-serif;
		font-synthesis: none;
	}

	a { color: inherit; text-decoration: none; }

	.page-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--grid-gap);
		padding-inline: var(--page-padding);
	}

	.sidebar {
		display: flex;
		grid-column: 1 / span 3;
		flex-direction: column;
		justify-content: space-between;
		height: 100svh;
		padding-block: var(--page-padding);
	}

	.identity { display: flex; align-items: flex-start; flex-direction: column; }
	.identity strong { font-size: var(--ui-font-size); font-weight: 400; line-height: var(--ui-line-height); }
	.identity > span { color: rgb(25 25 28 / 60%); font-size: var(--role-font-size); font-weight: 300; line-height: var(--ui-line-height); }
	.identity [data-scramble-text], .identity .scramble-link__char { display: inline-block; }

	nav {
		display: flex;
		align-items: center;
		font-size: var(--ui-font-size);
		font-weight: 400;
		line-height: var(--ui-line-height);
		white-space: nowrap;
	}

	.nav-separator {
		width: .2em;
		height: .2em;
		margin-inline: .4em;
		flex: none;
		border-radius: 50%;
		background: currentColor;
	}

	main {
		position: relative;
		display: grid;
		grid-column: 4 / span 9;
		grid-template-columns: repeat(9, minmax(0, 1fr));
		column-gap: var(--grid-gap);
		align-content: center;
		height: 100svh;
		min-width: 0;
	}

	.info-copy {
		display: flex;
		grid-column: 1 / span 8;
		flex-direction: column;
		gap: 48px;
		color: var(--color-muted);
		font-size: var(--info-font-size);
		font-weight: 400;
		line-height: var(--info-line-height);
		letter-spacing: 0;
	}

	.info-copy p { margin: 0; }
	.info-copy strong { color: var(--color-text); font-weight: inherit; }

	.visual {
		position: relative;
		display: inline-block;
		height: 1em;
		margin-inline: .1em;
		vertical-align: -.12em;
		overflow: hidden;
		border-radius: 3px;
		background: #d9d9d9;
	}

	.visual--wide { width: 2.08em; }
	.visual--long { width: 2.7em; }
	.visual--square { width: 1em; }
	.visual img { width: 100%; height: 100%; object-fit: cover; }

	.info-marker {
		position: absolute;
		bottom: calc(var(--page-padding) + 50px);
		left: calc((100% - var(--grid-gap) * 8) / 9 * 2 + var(--grid-gap) * 2);
		width: 36px;
		height: 1px;
		background: #eaeaeb;
	}
</style>
