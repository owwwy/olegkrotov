---
import '@fontsource-variable/onest';
import { projects } from '../data/projects';

const order = ['jetsite', 'addinol', 's-industrial', 'upravlead', 'podryado'];
const mobileProjects = order.map((slug) => projects.find((project) => project.slug === slug)).filter(Boolean);
const loopProjects = Array.from({ length: 3 }, (_, group) => mobileProjects.map((project) => ({ project, group }))).flat();
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="description" content="Олег Кротов — digital designer." />
		<title>Олег Кротов — Digital Designer</title>
	</head>
	<body>
		<header class="mobile-header">
			<span>Олег Кротов</span>
			<span>Digital Designer</span>
		</header>

		<main>
			<section class="mobile-info">
				<div class="mobile-info__copy">
					<p>
						<span class="info-row"><strong>Проектирую интерфейсы</strong></span>
						<span class="info-row"><span class="info-visual info-visual--01"><img src="/info/01.png" alt="" /></span><span>цифровых продуктов</span></span>
						<span class="info-row"><span>и&nbsp;</span><strong>развиваю дизайн-системы</strong><span>.</span></span>
					</p>
					<p>
						<span class="info-row"><span>Для меня хорошие продукты</span></span>
						<span class="info-row"><span>— это баланс</span><span class="info-visual info-visual--long"><img src="/info/03.png" alt="" /></span><span>между</span></span>
						<span class="info-row"><span>экспертизой, эстетикой</span></span>
						<span class="info-row"><span>и простыми исследованиями.</span></span>
					</p>
					<p>
						<span class="info-row"><span>Я глубоко ценю визуальную</span></span>
						<span class="info-row"><span>выразительность в цифровых</span></span>
						<span class="info-row"><span>продуктах, но считаю,</span></span>
						<span class="info-row"><span>что она&nbsp;</span><strong>должна работать</strong><span class="info-visual info-visual--hand"><img src="/info/05.png" alt="" /></span></span>
						<span class="info-row"><strong>в пользу понятности</strong></span>
						<span class="info-row"><strong>и интуитивности</strong><span>.</span></span>
					</p>
				</div>
			</section>

			<section class="project-marquee" aria-label="Проекты">
				<div class="project-marquee__viewport" data-project-marquee>
					<div class="project-marquee__track" data-project-track>
						{loopProjects.map(({ project, group }) => project && (
							<a
								class="project-card"
								href={`/${project.slug}`}
								aria-hidden={group === 1 ? undefined : 'true'}
								tabindex={group === 1 ? undefined : -1}
							>
								<img src={project.image} alt={group === 1 ? project.imageAlt : ''} loading="eager" decoding="async" draggable="false" />
								<div class="project-card__copy">
									<h2>{project.title}</h2>
									<p>{project.category}</p>
								</div>
							</a>
						))}
					</div>
				</div>
			</section>
		</main>

		<script>
			const updateScale = () => {
				const ratio = document.documentElement.clientWidth / 400;
				const root = document.documentElement.style;
				root.setProperty('--mobile-ratio', ratio.toString());
				root.setProperty('--info-top', `${120 * ratio}px`);
				root.setProperty('--side', `${24 * ratio}px`);
				root.setProperty('--bottom', `${32 * ratio}px`);
				root.setProperty('--inline-gap', `${6 * ratio}px`);
				root.setProperty('--copy-gap', `${20 * ratio}px`);
				root.setProperty('--visual-height', `${30 * ratio}px`);
				root.setProperty('--info-size', `${24 * ratio}px`);
				root.setProperty('--info-line', `${30 * ratio}px`);
				root.setProperty('--card-width', `${document.documentElement.clientWidth * .9}px`);
				root.setProperty('--card-media-gap', `${12 * ratio}px`);
				root.setProperty('--card-copy-gap', `${4 * ratio}px`);
				root.setProperty('--card-title-size', `${24 * ratio}px`);
				root.setProperty('--card-title-line', `${30 * ratio}px`);
				root.setProperty('--card-description-size', `${18 * ratio}px`);
				root.setProperty('--card-description-line', `${24 * ratio}px`);
				root.setProperty('--card-gap', `${2 * ratio}px`);
			};

			const viewport = document.querySelector<HTMLElement>('[data-project-marquee]');
			const track = document.querySelector<HTMLElement>('[data-project-track]');
			if (viewport && track) {
				const BASE_SPEED = 60;
				const IDLE_DELAY = 2400;
				const ACCELERATION_DURATION = 2000;
				let segmentWidth = 0;
				let resumeAt = Number.NEGATIVE_INFINITY;
				let previousFrame = performance.now();
				let lastAutoScroll = 0;
				let autoPosition = 0;
				let marqueeVisible = false;
				let gesture: null | { x: number; y: number; horizontal?: boolean } = null;
				let manualHorizontalScroll = false;
				let manualScrollEndTimer = 0;

				const measure = () => {
					const previousSegment = segmentWidth;
					segmentWidth = track.scrollWidth / 3;
					lastAutoScroll = performance.now();
					if (!previousSegment) viewport.scrollLeft = segmentWidth;
					else viewport.scrollLeft += segmentWidth - previousSegment;
					autoPosition = viewport.scrollLeft;
				};

				const normalizePosition = () => {
					if (!segmentWidth) return;
					if (viewport.scrollLeft < segmentWidth * .1) {
						viewport.scrollLeft += segmentWidth;
						autoPosition += segmentWidth;
					} else if (viewport.scrollLeft > segmentWidth * 1.9) {
						viewport.scrollLeft -= segmentWidth;
						autoPosition -= segmentWidth;
					}
				};

				const pauseAutoplay = () => {
					resumeAt = performance.now() + IDLE_DELAY;
				};

				const frame = (now: number) => {
					const elapsed = Math.min(50, now - previousFrame);
					previousFrame = now;
					let speed = BASE_SPEED;
					if (now < resumeAt) speed = 0;
					else if (Number.isFinite(resumeAt)) {
						const progress = Math.min(1, (now - resumeAt) / ACCELERATION_DURATION);
						speed = BASE_SPEED * progress * progress;
						if (progress === 1) resumeAt = Number.NEGATIVE_INFINITY;
					}
					if (speed > 0 && marqueeVisible && document.visibilityState === 'visible') {
						lastAutoScroll = now;
						autoPosition += speed * elapsed / 1000;
						viewport.scrollLeft = autoPosition;
						normalizePosition();
					}
					requestAnimationFrame(frame);
				};

				const visibilityObserver = new IntersectionObserver((entries) => {
					marqueeVisible = entries.some((entry) => entry.isIntersecting);
					previousFrame = performance.now();
				}, { rootMargin: '25% 0px', threshold: 0 });
				visibilityObserver.observe(viewport);

				viewport.addEventListener('pointerdown', (event) => {
					gesture = { x: event.clientX, y: event.clientY };
				}, { passive: true });
				viewport.addEventListener('pointermove', (event) => {
					if (!gesture || gesture.horizontal === false) return;
					const horizontalDistance = Math.abs(event.clientX - gesture.x);
					const verticalDistance = Math.abs(event.clientY - gesture.y);
					if (gesture.horizontal === undefined && Math.max(horizontalDistance, verticalDistance) >= 8) {
						gesture.horizontal = horizontalDistance > verticalDistance * 1.1;
					}
					if (gesture.horizontal) {
						manualHorizontalScroll = true;
						pauseAutoplay();
					}
				}, { passive: true });
				const finishGesture = () => { gesture = null; };
				viewport.addEventListener('pointerup', finishGesture, { passive: true });
				viewport.addEventListener('pointercancel', finishGesture, { passive: true });
				viewport.addEventListener('wheel', (event) => {
					if (Math.abs(event.deltaX) > Math.abs(event.deltaY) || event.shiftKey) {
						manualHorizontalScroll = true;
						pauseAutoplay();
					}
				}, { passive: true });
				viewport.addEventListener('scroll', () => {
					normalizePosition();
					if (performance.now() - lastAutoScroll > 80 && manualHorizontalScroll) {
						autoPosition = viewport.scrollLeft;
						pauseAutoplay();
						window.clearTimeout(manualScrollEndTimer);
						manualScrollEndTimer = window.setTimeout(() => { manualHorizontalScroll = false; }, 140);
					}
				}, { passive: true });
				window.addEventListener('resize', () => { updateScale(); measure(); }, { passive: true });

				updateScale();
				requestAnimationFrame(() => {
					measure();
					requestAnimationFrame(frame);
				});
			} else {
				updateScale();
				window.addEventListener('resize', updateScale, { passive: true });
			}
		</script>
	</body>
</html>

<style is:global>
	* { box-sizing: border-box; }
	html, body { margin: 0; background: #fff; }
	body {
		min-width: 0;
		color: #19191c;
		font-family: 'Onest Variable', Onest, sans-serif;
		-webkit-font-smoothing: antialiased;
	}
	a { color: inherit; text-decoration: none; }

	.mobile-header {
		display: flex;
		width: 100%;
		padding: calc(16px + env(safe-area-inset-top)) 16px 16px;
		border-bottom: 1px solid rgb(25 25 28 / 8%);
		justify-content: space-between;
		background: #fff;
		font-size: 18px;
		font-weight: 400;
		line-height: 24px;
	}
	.mobile-header > span:last-child { color: rgb(25 25 28 / 60%); font-weight: 300; }

	.mobile-info {
		display: flex;
		width: 100%;
		padding: var(--info-top, 120px) var(--side, 24px) var(--bottom, 32px);
		align-items: flex-end;
		overflow: hidden;
		background: #fff;
	}
	.mobile-info__copy {
		display: flex;
		width: 100%;
		flex-direction: column;
		gap: var(--copy-gap, 20px);
		color: rgb(25 25 28 / 56%);
		font-size: var(--info-size, 24px);
		font-weight: 400;
		line-height: var(--info-line, 30px);
		letter-spacing: 0;
	}
	.mobile-info__copy p { display: flex; margin: 0; flex-direction: column; }
	.info-row { display: flex; align-items: center; gap: var(--inline-gap, 6px); white-space: nowrap; }
	.info-row strong { color: #19191c; font-weight: inherit; }
	.info-visual {
		position: relative;
		display: inline-block;
		width: calc(var(--visual-height, 30px) * 52 / 30);
		height: var(--visual-height, 30px);
		flex: none;
		overflow: hidden;
		border-radius: calc(3px * var(--mobile-ratio, 1));
	}
	.info-visual--long { width: calc(var(--visual-height, 30px) * 81 / 30); }
	.info-visual--hand { width: var(--visual-height, 30px); overflow: visible; }
	.info-visual img { width: 100%; height: 100%; object-fit: cover; }
	.info-visual--hand img {
		width: calc(var(--visual-height, 30px) * 4 / 3);
		height: calc(var(--visual-height, 30px) * 4 / 3);
		transform: translate(-12.5%, -12.5%);
	}

	.project-marquee {
		width: 100%;
		padding-bottom: calc(32px * var(--mobile-ratio, 1) + env(safe-area-inset-bottom));
		overflow: hidden;
		background: #fff;
	}
	.project-marquee__viewport {
		width: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
		touch-action: pan-x pan-y;
	}
	.project-marquee__viewport::-webkit-scrollbar { display: none; }
	.project-marquee__track {
		display: flex;
		width: max-content;
		align-items: flex-end;
		gap: var(--card-gap, 2px);
	}
	.project-card {
		display: flex;
		width: var(--card-width, 360px);
		flex: none;
		flex-direction: column;
		gap: var(--card-media-gap, 12px);
		contain: layout paint;
	}
	.project-card > img {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		user-select: none;
		-webkit-user-drag: none;
	}
	.project-card__copy {
		display: flex;
		width: 100%;
		padding-inline: var(--side, 24px);
		flex-direction: column;
		gap: var(--card-copy-gap, 4px);
		text-align: center;
	}
	.project-card h2,
	.project-card p { margin: 0; }
	.project-card h2 {
		font-size: var(--card-title-size, 24px);
		font-weight: 500;
		line-height: var(--card-title-line, 30px);
		text-transform: uppercase;
	}
	.project-card p {
		color: rgb(25 25 28 / 60%);
		font-size: var(--card-description-size, 18px);
		font-weight: 400;
		line-height: var(--card-description-line, 24px);
	}

	@media (min-width: 768px) {
		body { max-width: 767px; margin-inline: auto; }
	}
</style>
