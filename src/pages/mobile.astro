---
import '../styles/fonts.css';
import SeoHead from '../components/SeoHead.astro';
import { projects } from '../data/projects';

const order = ['busa', 'jetsite', 'addinol', 's-industrial', 'upravlead', 'podryado'];
const mobileProjects = order.map((slug) => projects.find((project) => project.slug === slug)).filter(Boolean);
const loopProjects = Array.from({ length: 3 }, (_, group) => mobileProjects.map((project) => ({ project, group }))).flat();
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<meta name="theme-color" content="#ffffff" />
		<SeoHead
			title="Олег Кротов — Digital Designer"
			description="Портфолио Олега Кротова — digital designer. Проектирую интерфейсы цифровых продуктов, сайты и развиваю дизайн-системы."
		/>
	</head>
	<body>
		<header class="mobile-header">
			<span>Олег Кротов</span>
			<span>Digital Designer</span>
		</header>

		<main>
			<section class="mobile-info">
				<div class="mobile-info__copy">
					<p>
						<span class="info-row"><strong>Проектирую интерфейсы</strong></span>
						<span class="info-row"><span class="info-visual info-visual--01"><img src="/info/01.webp" alt="" /></span><span>цифровых продуктов</span></span>
						<span class="info-row"><span>и&nbsp;</span><strong>развиваю дизайн-системы</strong><span>.</span></span>
					</p>
					<p>
						<span class="info-row"><span>Для меня хорошие продукты&nbsp;</span></span>
						<span class="info-row"><span>— это баланс</span><span class="info-visual info-visual--long"><img src="/info/03.webp" alt="" /></span><span>между&nbsp;</span></span>
						<span class="info-row"><span>экспертизой, эстетикой</span></span>
						<span class="info-row"><span>и простыми исследованиями.</span></span>
					</p>
					<p>
						<span class="info-row"><span>Я глубоко ценю визуальную</span></span>
						<span class="info-row"><span>выразительность в цифровых</span></span>
						<span class="info-row"><span>продуктах, но считаю,</span></span>
						<span class="info-row"><span>что она&nbsp;</span><strong>должна работать</strong><span class="info-visual info-visual--hand"><img src="/info/05.webp" alt="" /></span></span>
						<span class="info-row"><strong>в пользу понятности</strong></span>
						<span class="info-row"><strong>и интуитивности</strong><span>.</span></span>
					</p>
				</div>
			</section>

			<section class="project-marquee" aria-label="Проекты">
				<div class="project-marquee__viewport" data-project-marquee>
					<div class="project-marquee__track" data-project-track>
						{loopProjects.map(({ project, group }) => project && (
							<a
								class="project-card"
								href={`/${project.slug}`}
								aria-hidden={group === 1 ? undefined : 'true'}
								tabindex={group === 1 ? undefined : -1}
							>
								<picture>
									<source srcset={project.image.replace('/projects/', '/projects-mobile/')} type="image/webp" />
									<img src={project.image} alt={group === 1 ? project.imageAlt : ''} loading="eager" decoding="async" draggable="false" />
								</picture>
								<div class="project-card__copy">
									<h2>{project.title}</h2>
									<p>{project.category}</p>
								</div>
							</a>
						))}
					</div>
				</div>
			</section>

			<footer class="mobile-footer">
				<div class="mobile-footer__divider" aria-hidden="true"></div>
				<div class="mobile-footer__contacts">
					<div class="mobile-footer__socials">
						<a href="https://t.me/okrotov" target="_blank" rel="noreferrer">Telegram</a>
						<span aria-hidden="true">·</span>
						<a href="https://max.ru/u/f9LHodD0cOILXFqd_giWUttuW0fJCK-4NuRFIyyzoKhCGxHFcx__MM_5_GU" target="_blank" rel="noreferrer">Max</a>
						<span aria-hidden="true">·</span>
						<a href="https://dprofile.ru/owdesy" target="_blank" rel="noreferrer">Dprofile</a>
						<span aria-hidden="true">·</span>
						<a href="https://vk.ru/krotov.oleg" target="_blank" rel="noreferrer">Vkontakte</a>
					</div>
					<a href="tel:+79996930693" data-phone-link>8 (999) 693-0-693</a>
				</div>
			</footer>
		</main>

		<script>
			import { animatePermutation } from '../scripts/scramble';
			const mobileLockedCharacters = new Set([' ', '\u00a0']);
			const scrambleTapText = (element: HTMLElement) => {
				if (element.dataset.tapScrambleReady === 'true') return;
				const protectShortWords = (value: string) => {
					const pattern = /(^|\s)(в|во|и|а|но|к|ко|с|со|у|о|об|обо|на|по|из|за|от|до|для|при|без|под|над|не)\s+/giu;
					let protectedValue = value;
					let previous = '';
					while (previous !== protectedValue) {
						previous = protectedValue;
						protectedValue = protectedValue.replace(pattern, '$1$2\u00a0');
					}
					return protectedValue;
				};
				const original = [...protectShortWords(element.textContent ?? '')];
				element.textContent = '';
				const spans: HTMLSpanElement[] = [];
				let word: HTMLSpanElement | null = null;
				original.forEach((character, index) => {
					const span = document.createElement('span');
					span.className = 'tap-scramble-char';
					span.textContent = character === ' ' || character === '\u00a0' ? '\u00a0' : character;
					spans[index] = span;
					if (character === ' ') {
						element.append(span);
						word = null;
					} else {
						if (!word) {
							word = document.createElement('span');
							word.className = 'tap-scramble-word';
							element.append(word);
						}
						word.append(span);
					}
				});
				element.dataset.tapScrambleReady = 'true';
				element.addEventListener('pointerdown', () => {
					if (element.dataset.tapScrambling === 'true') return;
					element.dataset.tapScrambling = 'true';
					void animatePermutation({
						spans,
						value: original,
						lockedCharacters: mobileLockedCharacters,
						tickInterval: () => 46,
					}).then(() => { element.dataset.tapScrambling = 'false'; });
				}, { passive: true });
			};
			document.querySelectorAll<HTMLElement>('.project-card__copy h2, .project-card__copy p, .mobile-footer a').forEach(scrambleTapText);
			const phoneLink = document.querySelector<HTMLAnchorElement>('[data-phone-link]');
			phoneLink?.addEventListener('click', async (event) => {
				event.preventDefault();
				try { await navigator.clipboard?.writeText('8 (999) 693-0-693'); } catch {}
				window.location.href = phoneLink.href;
			});
			document.querySelectorAll<HTMLAnchorElement>('.project-card').forEach((link) => {
				link.addEventListener('click', (event) => {
					event.preventDefault();
					window.setTimeout(() => window.location.assign(link.href), 144);
				});
			});

			const updateScale = () => {
				const ratio = document.documentElement.clientWidth / 400;
				const root = document.documentElement.style;
				root.setProperty('--mobile-ratio', ratio.toString());
				root.setProperty('--info-top', `${120 * ratio}px`);
				root.setProperty('--side', `${24 * ratio}px`);
				root.setProperty('--bottom', `${32 * ratio}px`);
				root.setProperty('--inline-gap', `${6 * ratio}px`);
				root.setProperty('--copy-gap', `${20 * ratio}px`);
				root.setProperty('--visual-height', `${30 * ratio}px`);
				root.setProperty('--info-size', `${24 * ratio}px`);
				root.setProperty('--info-line', `${30 * ratio}px`);
				root.setProperty('--card-width', `${document.documentElement.clientWidth * .9}px`);
				root.setProperty('--card-media-gap', `${12 * ratio}px`);
				root.setProperty('--card-copy-gap', `${4 * ratio}px`);
				root.setProperty('--card-title-size', `${24 * ratio}px`);
				root.setProperty('--card-title-line', `${30 * ratio}px`);
				root.setProperty('--card-description-size', `${18 * ratio}px`);
				root.setProperty('--card-description-line', `${24 * ratio}px`);
				root.setProperty('--card-gap', `${2 * ratio}px`);
			};

			const viewport = document.querySelector<HTMLElement>('[data-project-marquee]');
			const track = document.querySelector<HTMLElement>('[data-project-track]');
			if (viewport && track) {
				const BASE_SPEED = 60;
				const IDLE_DELAY = 2400;
				const ACCELERATION_DURATION = 2000;
				const INERTIA_FRICTION = 2.35;
				let segmentWidth = 0;
				let resumeAt = Number.NEGATIVE_INFINITY;
				let previousFrame = performance.now();
				let position = 0;
				let inertiaVelocity = 0;
				let marqueeVisible = false;
				let suppressClickUntil = 0;
				let wheelEndTimer = 0;
				let gesture: null | {
					pointerId: number;
					startX: number;
					startY: number;
					lastX: number;
					lastAt: number;
					horizontal?: boolean;
					velocity: number;
				} = null;

				const render = () => {
					track.style.transform = `translate3d(${-position}px, 0, 0)`;
				};

				const measure = () => {
					const previousSegment = segmentWidth;
					segmentWidth = track.scrollWidth / 3;
					if (!previousSegment) position = segmentWidth;
					else position += segmentWidth - previousSegment;
					render();
					track.style.visibility = 'visible';
				};

				const normalizePosition = () => {
					if (!segmentWidth) return;
					while (position < segmentWidth * .5) position += segmentWidth;
					while (position > segmentWidth * 1.5) position -= segmentWidth;
				};

				const scheduleAutoplay = () => {
					resumeAt = performance.now() + IDLE_DELAY;
				};

				const frame = (now: number) => {
					const elapsed = Math.min(50, now - previousFrame);
					previousFrame = now;
					if (marqueeVisible && document.visibilityState === 'visible' && !gesture?.horizontal) {
						const seconds = elapsed / 1000;
						if (Math.abs(inertiaVelocity) > 2) {
							position += inertiaVelocity * seconds;
							inertiaVelocity *= Math.exp(-INERTIA_FRICTION * seconds);
							if (Math.abs(inertiaVelocity) <= 2) {
								inertiaVelocity = 0;
								scheduleAutoplay();
							}
						} else {
							let speed = BASE_SPEED;
							if (now < resumeAt) speed = 0;
							else if (Number.isFinite(resumeAt)) {
								const progress = Math.min(1, (now - resumeAt) / ACCELERATION_DURATION);
								speed = BASE_SPEED * progress * progress;
								if (progress === 1) resumeAt = Number.NEGATIVE_INFINITY;
							}
							position += speed * seconds;
						}
						normalizePosition();
						render();
					}
					requestAnimationFrame(frame);
				};

				const visibilityObserver = new IntersectionObserver((entries) => {
					marqueeVisible = entries.some((entry) => entry.isIntersecting);
					previousFrame = performance.now();
				}, { rootMargin: '25% 0px', threshold: 0 });
				visibilityObserver.observe(viewport);

				viewport.addEventListener('pointerdown', (event) => {
					gesture = {
						pointerId: event.pointerId,
						startX: event.clientX,
						startY: event.clientY,
						lastX: event.clientX,
						lastAt: performance.now(),
						velocity: 0,
					};
				}, { passive: true });
				viewport.addEventListener('pointermove', (event) => {
					if (!gesture || gesture.horizontal === false) return;
					const horizontalDistance = Math.abs(event.clientX - gesture.startX);
					const verticalDistance = Math.abs(event.clientY - gesture.startY);
					if (gesture.horizontal === undefined && Math.max(horizontalDistance, verticalDistance) >= 8) {
						gesture.horizontal = horizontalDistance > verticalDistance * 1.1;
						if (gesture.horizontal) {
							inertiaVelocity = 0;
							resumeAt = Number.POSITIVE_INFINITY;
							viewport.setPointerCapture(event.pointerId);
						}
					}
					if (gesture.horizontal) {
						event.preventDefault();
						const now = performance.now();
						const delta = event.clientX - gesture.lastX;
						const elapsed = Math.max(1, now - gesture.lastAt);
						position -= delta;
						const instantVelocity = -delta / elapsed * 1000;
						gesture.velocity = gesture.velocity * .55 + instantVelocity * .45;
						gesture.lastX = event.clientX;
						gesture.lastAt = now;
						normalizePosition();
						render();
					}
				}, { passive: false });
				const finishGesture = () => {
					if (!gesture) return;
					if (gesture.horizontal) {
						inertiaVelocity = Math.max(-2400, Math.min(2400, gesture.velocity));
						suppressClickUntil = performance.now() + 350;
						if (viewport.hasPointerCapture(gesture.pointerId)) viewport.releasePointerCapture(gesture.pointerId);
						if (Math.abs(inertiaVelocity) <= 2) scheduleAutoplay();
					}
					gesture = null;
				};
				viewport.addEventListener('pointerup', finishGesture, { passive: true });
				viewport.addEventListener('pointercancel', finishGesture, { passive: true });
				viewport.addEventListener('wheel', (event) => {
					if (Math.abs(event.deltaX) > Math.abs(event.deltaY) || event.shiftKey) {
						event.preventDefault();
						const delta = event.shiftKey && Math.abs(event.deltaX) < Math.abs(event.deltaY) ? event.deltaY : event.deltaX;
						position += delta;
						inertiaVelocity = Math.max(-1800, Math.min(1800, delta * 18));
						resumeAt = Number.POSITIVE_INFINITY;
						normalizePosition();
						render();
						window.clearTimeout(wheelEndTimer);
						wheelEndTimer = window.setTimeout(() => {
							if (Math.abs(inertiaVelocity) <= 2) scheduleAutoplay();
						}, 120);
					}
				}, { passive: false });
				viewport.addEventListener('click', (event) => {
					if (performance.now() < suppressClickUntil) {
						event.preventDefault();
						event.stopPropagation();
					}
				}, true);
				window.addEventListener('resize', () => { updateScale(); measure(); }, { passive: true });

				updateScale();
				requestAnimationFrame(() => {
					measure();
					requestAnimationFrame(frame);
				});
			} else {
				updateScale();
				window.addEventListener('resize', updateScale, { passive: true });
			}
		</script>
	</body>
</html>

<style is:global>
	* { box-sizing: border-box; }
	html, body { margin: 0; background: #fff; }
	body {
		min-width: 0;
		color: #19191c;
		font-family: 'Onest Variable', Onest, sans-serif;
		-webkit-font-smoothing: antialiased;
	}
	a { color: inherit; text-decoration: none; }

	.mobile-header {
		display: flex;
		width: 100%;
		padding: calc(16px + env(safe-area-inset-top)) 16px 16px;
		border-bottom: 1px solid rgb(25 25 28 / 8%);
		justify-content: space-between;
		background: #fff;
		font-size: 18px;
		font-weight: 400;
		line-height: 24px;
	}
	.mobile-header > span:last-child { color: rgb(25 25 28 / 60%); font-weight: 300; }

	.mobile-info {
		display: flex;
		width: 100%;
		padding: var(--info-top, 120px) var(--side, 24px) var(--bottom, 32px);
		align-items: flex-end;
		overflow: hidden;
		background: #fff;
	}
	.mobile-info__copy {
		display: flex;
		width: 100%;
		flex-direction: column;
		gap: var(--copy-gap, 20px);
		color: rgb(25 25 28 / 56%);
		font-size: var(--info-size, 24px);
		font-weight: 400;
		line-height: var(--info-line, 30px);
		letter-spacing: 0;
	}
	.mobile-info__copy p { display: flex; margin: 0; flex-direction: column; }
	.info-row { display: flex; align-items: center; gap: var(--inline-gap, 6px); white-space: nowrap; }
	.info-row strong { color: #19191c; font-weight: inherit; }
	.info-visual {
		position: relative;
		display: inline-block;
		width: calc(var(--visual-height, 30px) * 52 / 30);
		height: var(--visual-height, 30px);
		flex: none;
		overflow: hidden;
		border-radius: calc(3px * var(--mobile-ratio, 1));
	}
	.info-visual--long { width: calc(var(--visual-height, 30px) * 81 / 30); }
	.info-visual--hand { width: var(--visual-height, 30px); overflow: visible; }
	.info-visual img { width: 100%; height: 100%; object-fit: cover; }
	.info-visual--hand img {
		width: calc(var(--visual-height, 30px) * 4 / 3);
		height: calc(var(--visual-height, 30px) * 4 / 3);
		transform: translate(-12.5%, -12.5%);
	}

	.project-marquee {
		width: 100%;
		overflow: hidden;
		background: #fff;
	}
	.project-marquee__viewport {
		width: 100%;
		overflow: hidden;
		touch-action: pan-y;
	}
	.project-marquee__track {
		display: flex;
		width: max-content;
		align-items: flex-end;
		gap: var(--card-gap, 2px);
		visibility: hidden;
		will-change: transform;
	}
	.project-card {
		display: flex;
		width: var(--card-width, 360px);
		flex: none;
		flex-direction: column;
		gap: var(--card-media-gap, 12px);
		contain: layout paint;
	}
	.project-card > picture,
	.project-card > picture > img {
		display: block;
		width: 100%;
		aspect-ratio: 1;
	}
	.project-card > picture > img {
		object-fit: cover;
		user-select: none;
		-webkit-user-drag: none;
	}
	.project-card__copy {
		display: flex;
		width: 100%;
		padding-inline: var(--side, 24px);
		flex-direction: column;
		gap: var(--card-copy-gap, 4px);
		text-align: center;
	}
	.project-card h2,
	.project-card p { margin: 0; }
	.project-card h2 {
		font-size: var(--card-title-size, 24px);
		font-weight: 500;
		line-height: var(--card-title-line, 30px);
		text-transform: uppercase;
	}
	.project-card p {
		color: rgb(25 25 28 / 60%);
		font-size: var(--card-description-size, 18px);
		font-weight: 400;
		line-height: var(--card-description-line, 24px);
	}
	.mobile-footer {
		display: flex;
		width: 100%;
		padding: 60px 24px calc(32px + env(safe-area-inset-bottom));
		flex-direction: column;
		justify-content: flex-end;
		align-items: flex-start;
		gap: 32px;
		overflow: hidden;
		background: #fff;
	}
	.mobile-footer__divider {
		width: 100%;
		height: 1px;
		flex: none;
		background: rgb(25 25 28 / 8%);
	}
	.mobile-footer__contacts {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 20px;
		font-size: 18px;
		font-weight: 400;
		line-height: 24px;
	}
	.mobile-footer__socials { display: flex; align-items: flex-start; gap: 6px; }
	.mobile-footer [data-phone-link] { white-space: nowrap; }
	.tap-scramble-word { display: inline-block; }
	.tap-scramble-char { display: inline-block; }

	@media (min-width: 768px) {
		body { max-width: 767px; margin-inline: auto; }
	}
</style>
