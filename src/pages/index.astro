---
import '@fontsource-variable/onest';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import ScrambleLink from '../components/ScrambleLink.astro';
import TypeScale from '../components/TypeScale.astro';
import { projects } from '../data/projects';

const navigation = [
	{ label: 'Проекты', href: '#works', active: true },
	{ label: 'Инфо', href: '#about' },
	{ label: 'Контакты', href: '#contacts' },
];

---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<style is:inline>html,body{margin:0;background:#fff}</style>
		<script is:inline>document.documentElement.classList.add('is-preloading');</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<TypeScale />
		<meta
			name="description"
			content="Портфолио Олега Кротова — digital designer."
		/>
		<title>Олег Кротов — Digital Designer</title>
	</head>
	<body>
		<div class="site-preloader" data-site-preloader aria-live="polite">
			<div class="site-preloader__identity" data-preloader-identity>
				<strong data-preloader-name></strong>
				<span data-preloader-role></span>
			</div>
		</div>
		<div class="page-grid">
			<aside class="sidebar">
				<a class="identity" href="/" aria-label="Олег Кротов — на главную" data-scramble-link>
					<strong data-scramble-text data-original="Олег Кротов">
						{[...'Олег Кротов'].map((character) => (
							<span class="scramble-link__char">{character === ' ' ? '\u00a0' : character}</span>
						))}
					</strong>
					<span data-scramble-text data-original="Digital Designer">
						{[...'Digital Designer'].map((character) => (
							<span class="scramble-link__char">{character === ' ' ? '\u00a0' : character}</span>
						))}
					</span>
				</a>

				<nav aria-label="Основная навигация">
					{navigation.map((item, index) => (
						<>
							<ScrambleLink href={item.href} label={item.label} active={item.active} />
							{index < navigation.length - 1 && <span class="nav-separator" aria-hidden="true"></span>}
						</>
					))}
				</nav>
			</aside>

			<main id="works">
				<ProjectShowcase projects={projects} />
			</main>
		</div>
		<script is:inline>
			(() => {
				const startedAt = performance.now();
				const loader = document.querySelector('[data-site-preloader]');
				const loaderIdentity = document.querySelector('[data-preloader-identity]');
				const loaderName = document.querySelector('[data-preloader-name]');
				const loaderRole = document.querySelector('[data-preloader-role]');
				const targetIdentity = document.querySelector('.identity');
				if (!loader || !loaderIdentity || !loaderName || !loaderRole || !targetIdentity) return;

				const name = 'Олег Кротов';
				const role = 'Digital Designer';
				const poolFor = (value) => [...new Set([...value].filter((character) => character !== ' '))];
				const randomFrom = (pool) => pool[Math.floor(Math.random() * pool.length)] || '';
				const draw = (element, characters) => {
					element.textContent = characters.map((character) => character === ' ' ? '\u00a0' : character).join('');
				};
				draw(loaderName, [...name]);
				draw(loaderRole, [...role]);
				const loaderBounds = loaderIdentity.getBoundingClientRect();
				loaderIdentity.style.width = `${loaderBounds.width}px`;
				loaderIdentity.style.height = `${loaderBounds.height}px`;
				draw(loaderName, []);
				draw(loaderRole, []);
				const visibleCharacters = [0, 0];
				const previousCharacters = [[], []];
				const values = [name, role];
				const elements = [loaderName, loaderRole];
				const scramble = () => {
					values.forEach((value, valueIndex) => {
						const source = [...value].slice(0, visibleCharacters[valueIndex]);
						const pool = poolFor(value);
						const output = source.map((character, characterIndex) => {
							if (character === ' ') return character;
							const previous = previousCharacters[valueIndex][characterIndex];
							const alternatives = pool.filter((candidate) => candidate !== previous);
							return randomFrom(alternatives.length ? alternatives : pool);
						});
						previousCharacters[valueIndex] = output;
						draw(elements[valueIndex], output);
					});
				};
				const scrambleTimer = window.setInterval(scramble, 58);
				const build = (valueIndex, value, duration) => new Promise((resolve) => {
					const source = [...value];
					const animationStartedAt = performance.now();
					const frame = (now) => {
						const progress = Math.min(1, (now - animationStartedAt) / duration);
						visibleCharacters[valueIndex] = Math.ceil(progress * source.length);
						if (progress < 1) requestAnimationFrame(frame);
						else resolve();
					};
					requestAnimationFrame(frame);
				});
				const loaded = Promise.all([
					document.fonts?.ready || Promise.resolve(),
					...[...document.querySelectorAll('[data-project-panel] img')].map((image) =>
						image.complete ? Promise.resolve() : new Promise((resolve) => {
							image.addEventListener('load', resolve, { once: true });
							image.addEventListener('error', resolve, { once: true });
						}),
					),
				]);

				(async () => {
					await build(0, name, 390);
					await build(1, role, 430);
					await Promise.all([
						loaded,
						new Promise((resolve) => window.setTimeout(resolve, Math.max(0, 1200 - (performance.now() - startedAt)))),
					]);
					window.clearInterval(scrambleTimer);
					draw(loaderName, [...name]);
					draw(loaderRole, [...role]);
					await new Promise((resolve) => window.setTimeout(resolve, 140));

					const target = targetIdentity.getBoundingClientRect();
					const source = loaderIdentity.getBoundingClientRect();
					loaderIdentity.style.setProperty('--loader-x', `${target.left - source.left}px`);
					loaderIdentity.style.setProperty('--loader-y', `${target.top - source.top}px`);
					loader.classList.add('is-returning');
					loaderIdentity.classList.add('is-returning');
					window.setTimeout(() => {
						document.documentElement.classList.add('is-revealing');
						window.dispatchEvent(new CustomEvent('site:reveal'));
					}, 260);
					window.setTimeout(() => {
						document.documentElement.classList.add('is-identity-ready');
					}, 610);
					window.setTimeout(() => {
						document.documentElement.classList.remove('is-preloading');
						document.documentElement.classList.remove('is-identity-ready');
						loader.remove();
					}, 760);
				})();
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--page-padding: 40px;
		--grid-gap: 20px;
		--grid-columns: 12;
		--color-text: #19191c;
		--color-muted: rgb(25 25 28 / 60%);
		--color-background: #fff;
		--color-project: #d6e0e5;
		--ui-font-size: 20px;
		--ui-line-height: 24px;
		--role-font-size: 16px;
		--project-title-size: 120px;
		--project-title-line-height: 120px;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
		scrollbar-width: none;
	}

	*::-webkit-scrollbar {
		display: none;
		width: 0;
		height: 0;
	}

	.site-preloader {
		position: fixed;
		z-index: 1000;
		inset: 0;
		display: grid;
		place-items: center;
		background: #fff;
		transition: background-color 500ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.site-preloader.is-returning {
		background: rgb(255 255 255 / 0%);
		pointer-events: none;
	}

	.site-preloader__identity {
		display: flex;
		flex-direction: column;
		transform: translate3d(0, 0, 0);
		transform-origin: top left;
		transition: transform 640ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.site-preloader__identity.is-returning {
		transform: translate3d(var(--loader-x), var(--loader-y), 0) scale(0.5);
	}

	.site-preloader__identity strong {
		font-size: calc(var(--ui-font-size) * 2);
		font-weight: 400;
		line-height: calc(var(--ui-line-height) * 2);
	}

	.site-preloader__identity span {
		color: var(--color-muted);
		font-size: calc(var(--role-font-size) * 2);
		font-weight: 300;
		line-height: calc(var(--ui-line-height) * 2);
	}

	.is-preloading .identity,
	.is-preloading nav,
	.is-preloading main {
		opacity: 0;
	}

	.identity,
	nav,
	main {
		transition: opacity 420ms ease-out;
	}

	.is-preloading.is-revealing nav,
	.is-preloading.is-revealing main {
		opacity: 1;
	}

	.is-preloading.is-identity-ready .identity {
		opacity: 1;
	}

	.c-scrollbar {
		display: none !important;
	}

	html {
		min-width: 1140px;
		height: 100%;
		background: var(--color-background);
		overflow: hidden;
	}

	body {
		height: 100%;
		margin: 0;
		color: var(--color-text);
		background: var(--color-background);
		font-family: 'Onest Variable', Onest, sans-serif;
		font-synthesis: none;
		overflow: hidden;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.page-grid {
		display: grid;
		grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
		column-gap: var(--grid-gap);
		padding-inline: var(--page-padding);
	}

	.sidebar {
		position: sticky;
		top: 0;
		display: flex;
		grid-column: 1 / span 3;
		flex-direction: column;
		justify-content: space-between;
		height: 100svh;
		padding-block: var(--page-padding);
	}

	.identity {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
	}

	.identity strong {
		font-size: var(--ui-font-size);
		font-weight: 400;
		line-height: var(--ui-line-height);
	}

	.identity > span {
		color: var(--color-muted);
		font-size: var(--role-font-size);
		font-weight: 300;
		line-height: var(--ui-line-height);
	}

	.identity [data-scramble-text],
	.identity .scramble-link__char {
		display: inline-block;
	}

	nav {
		display: flex;
		align-items: center;
		font-size: var(--ui-font-size);
		font-weight: 400;
		line-height: var(--ui-line-height);
		white-space: nowrap;
	}

	.nav-separator {
		width: 0.2em;
		height: 0.2em;
		margin-inline: 0.4em;
		flex: none;
		border-radius: 50%;
		background: currentColor;
	}

	main {
		grid-column: 4 / span 9;
		min-width: 0;
	}
</style>
