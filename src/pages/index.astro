---
import '../styles/fonts.css';
import ClientRouting from '../components/ClientRouting.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import SeoHead from '../components/SeoHead.astro';
import SiteSidebar from '../components/SiteSidebar.astro';
import TypeScale from '../components/TypeScale.astro';
import { projects } from '../data/projects';

---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<ClientRouting />
		<style is:inline>
			html,body{margin:0;background:#fff}
			html.info-return-home .site-preloader,
			html.case-return-home .site-preloader{display:none!important}
			@media(max-width:767px){[data-site-preloader]{display:none!important}}
		</style>
		<script is:inline>
			if (window.matchMedia('(max-width: 767px)').matches) window.location.replace('/mobile');
		</script>
		<script is:inline data-astro-rerun>
			document.documentElement.classList.remove(
				'info-entering', 'info-ready', 'info-return-home', 'info-return-ready',
				'case-return-home', 'case-return-ready', 'is-preloading', 'is-revealing', 'is-identity-ready'
			);
			const returnParameters = new URLSearchParams(window.location.search);
			const caseReturnFromUrl = returnParameters.has('case-return');
			const infoReturnFromUrl = returnParameters.has('info-return');
			if (caseReturnFromUrl || infoReturnFromUrl) {
				window.history.replaceState(window.history.state, '', '/');
			}
			const mobileLayout = window.matchMedia('(max-width: 767px)').matches;
			if (mobileLayout) document.documentElement.classList.add('mobile-layout');
			else document.documentElement.classList.remove('mobile-layout');
			try {
				if (mobileLayout) {
					sessionStorage.removeItem('case-return-home');
					sessionStorage.removeItem('info-return-home');
				} else if (caseReturnFromUrl || sessionStorage.getItem('case-return-home') === 'true') {
					document.documentElement.classList.add('case-return-home');
					sessionStorage.removeItem('case-return-home');
				} else if (infoReturnFromUrl || sessionStorage.getItem('info-return-home') === 'true') {
					document.documentElement.classList.add('info-return-home');
					sessionStorage.removeItem('info-return-home');
				} else document.documentElement.classList.add('is-preloading');
			} catch { document.documentElement.classList.add('is-preloading'); }
			window.addEventListener('pageshow', (event) => {
				if (event.persisted) window.location.reload();
			});
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#ffffff" data-site-theme-color />
		<meta name="generator" content={Astro.generator} />
		<TypeScale />
		<SeoHead
			title="Олег Кротов — Digital Designer и продуктовый дизайнер"
			description="Портфолио Олега Кротова — digital designer. Проектирую интерфейсы цифровых продуктов, сайты и развиваю дизайн-системы."
		/>
	</head>
	<body>
		<div class="site-preloader" data-site-preloader aria-live="polite">
			<div class="site-preloader__identity" data-preloader-identity>
				<strong data-preloader-name></strong>
				<span data-preloader-role></span>
			</div>
		</div>
		<div class="page-grid">
			<SiteSidebar active="projects" />

			<main id="works">
				<h1 class="seo-heading">Олег Кротов — Digital Designer и продуктовый дизайнер</h1>
				<ProjectShowcase projects={projects} />
			</main>
		</div>
		<script is:inline data-astro-rerun>
			(() => {
				if (document.documentElement.classList.contains('mobile-layout')) {
					document.querySelector('[data-site-preloader]')?.remove();
					return;
				}
				if (
					document.documentElement.classList.contains('info-return-home')
					|| document.documentElement.classList.contains('case-return-home')
				) {
					document.querySelector('[data-site-preloader]')?.remove();
					return;
				}
				const startedAt = performance.now();
				const loader = document.querySelector('[data-site-preloader]');
				const loaderIdentity = document.querySelector('[data-preloader-identity]');
				const loaderName = document.querySelector('[data-preloader-name]');
				const loaderRole = document.querySelector('[data-preloader-role]');
				const targetIdentity = document.querySelector('.identity');
				if (!loader || !loaderIdentity || !loaderName || !loaderRole || !targetIdentity) return;

				const name = 'Олег Кротов';
				const role = 'Digital Designer';
				const poolFor = (value) => [...new Set([...value].filter((character) => character !== ' '))];
				const randomFrom = (pool) => pool[Math.floor(Math.random() * pool.length)] || '';
				const draw = (element, characters) => {
					element.textContent = characters.map((character) => character === ' ' ? '\u00a0' : character).join('');
				};
				draw(loaderName, [...name]);
				draw(loaderRole, [...role]);
				const loaderBounds = loaderIdentity.getBoundingClientRect();
				loaderIdentity.style.width = `${loaderBounds.width}px`;
				loaderIdentity.style.height = `${loaderBounds.height}px`;
				const visibleCharacters = [0, 0];
				const settledCharacters = [0, 0];
				const previousCharacters = [[], []];
				const values = [name, role];
				const elements = [loaderName, loaderRole];
				const scramble = () => {
					values.forEach((value, valueIndex) => {
						const source = [...value];
						const pool = poolFor(value);
						const output = source.map((character, characterIndex) => {
							if (characterIndex >= visibleCharacters[valueIndex]) return '';
							if (character === ' ') return character;
							if (characterIndex < settledCharacters[valueIndex]) return character;
							const previous = previousCharacters[valueIndex][characterIndex];
							const alternatives = pool.filter((candidate) => candidate !== previous);
							return randomFrom(alternatives.length ? alternatives : pool);
						});
						previousCharacters[valueIndex] = output;
						draw(elements[valueIndex], output);
					});
				};
				const scrambleTimer = window.setInterval(scramble, 58);
				draw(loaderName, []);
				draw(loaderRole, []);
				const build = (valueIndex, value, duration, delay = 0) => new Promise((resolve) => {
					const source = [...value];
					const animationStartedAt = performance.now() + delay;
					const frame = (now) => {
						if (now < animationStartedAt) {
							requestAnimationFrame(frame);
							return;
						}
						const progress = Math.min(1, (now - animationStartedAt) / duration);
						const typingProgress = Math.min(1, progress / 0.68);
						const settlingProgress = Math.max(0, (progress - 0.68) / 0.32);
						visibleCharacters[valueIndex] = Math.ceil(typingProgress * source.length);
						settledCharacters[valueIndex] = Math.floor(
							(1 - Math.pow(1 - settlingProgress, 2)) * source.length,
						);
						if (progress < 1) requestAnimationFrame(frame);
						else {
							settledCharacters[valueIndex] = source.length;
							resolve();
						}
					};
					requestAnimationFrame(frame);
				});
				const loaded = Promise.all([
					document.fonts?.ready || Promise.resolve(),
					...[...document.querySelectorAll('[data-project-panel] img')].map((image) =>
						image.complete ? Promise.resolve() : new Promise((resolve) => {
							image.addEventListener('load', resolve, { once: true });
							image.addEventListener('error', resolve, { once: true });
						}),
					),
				]);

				(async () => {
					await Promise.all([
						build(0, name, 680),
						build(1, role, 760, 90),
					]);
					window.clearInterval(scrambleTimer);
					draw(loaderName, [...name]);
					draw(loaderRole, [...role]);

					let glitchRestore = 0;
					const glitch = () => {
						const valueIndex = Math.random() < 0.62 ? 0 : 1;
						const value = values[valueIndex];
						const pool = poolFor(value);
						const output = [...value];
						const mutable = output.flatMap((character, index) => character === ' ' ? [] : [index]);
						const changes = Math.random() < 0.7 ? 1 : 2;
						for (let index = 0; index < changes && mutable.length; index += 1) {
							const slot = mutable.splice(Math.floor(Math.random() * mutable.length), 1)[0];
							const alternatives = pool.filter((character) => character !== output[slot]);
							output[slot] = randomFrom(alternatives.length ? alternatives : pool);
						}
						draw(elements[valueIndex], output);
						window.clearTimeout(glitchRestore);
						glitchRestore = window.setTimeout(() => draw(elements[valueIndex], [...value]), 72);
					};
					const glitchTimer = window.setInterval(glitch, 190 + Math.random() * 90);
					await Promise.all([
						loaded,
						new Promise((resolve) => window.setTimeout(resolve, Math.max(0, 1200 - (performance.now() - startedAt)))),
					]);
					window.clearInterval(glitchTimer);
					window.clearTimeout(glitchRestore);
					draw(loaderName, [...name]);
					draw(loaderRole, [...role]);
					await new Promise((resolve) => window.setTimeout(resolve, 140));

					const target = targetIdentity.getBoundingClientRect();
					const source = loaderIdentity.getBoundingClientRect();
					loaderIdentity.style.setProperty('--loader-x', `${target.left - source.left}px`);
					loaderIdentity.style.setProperty('--loader-y', `${target.top - source.top}px`);
					loader.classList.add('is-returning');
					loaderIdentity.classList.add('is-returning');
					window.setTimeout(() => {
						document.documentElement.classList.add('is-revealing');
						window.dispatchEvent(new CustomEvent('site:reveal'));
					}, 260);
					window.setTimeout(() => {
						document.documentElement.classList.add('is-identity-ready');
					}, 610);
					window.setTimeout(() => {
						document.documentElement.classList.remove('is-preloading');
						document.documentElement.classList.remove('is-identity-ready');
						loader.remove();
					}, 760);
				})();
			})();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--page-padding: 40px;
		--grid-gap: 20px;
		--grid-columns: 12;
		--color-text: #19191c;
		--color-muted: rgb(25 25 28 / 60%);
		--color-background: #fff;
		--color-project: #d6e0e5;
		--ui-font-size: 20px;
		--ui-line-height: 24px;
		--role-font-size: 16px;
		--project-title-size: 120px;
		--project-title-line-height: 120px;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
		scrollbar-width: none;
	}

	*::-webkit-scrollbar {
		display: none;
		width: 0;
		height: 0;
	}

	.seo-heading {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	.site-preloader {
		position: fixed;
		z-index: 1000;
		inset: 0;
		display: grid;
		place-items: center;
		background: #fff;
		transition: background-color 500ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.site-preloader.is-returning {
		background: rgb(255 255 255 / 0%);
		pointer-events: none;
	}

	.site-preloader__identity {
		display: flex;
		flex-direction: column;
		transform: translate3d(0, 0, 0);
		transform-origin: top left;
		transition: transform 640ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.site-preloader__identity.is-returning {
		transform: translate3d(var(--loader-x), var(--loader-y), 0) scale(0.5);
	}

	.site-preloader__identity strong {
		font-size: calc(var(--ui-font-size) * 2);
		font-weight: 400;
		line-height: calc(var(--ui-line-height) * 2);
	}

	.site-preloader__identity span {
		color: var(--color-muted);
		font-size: calc(var(--role-font-size) * 2);
		font-weight: 300;
		line-height: calc(var(--ui-line-height) * 2);
	}

	.is-preloading .identity,
	.is-preloading nav,
	.is-preloading main {
		opacity: 0;
	}

	.identity,
	nav,
	main {
		transition: opacity 420ms ease-out;
	}

	.is-preloading.is-revealing nav,
	.is-preloading.is-revealing main {
		opacity: 1;
	}

	.is-preloading.is-identity-ready .identity {
		opacity: 1;
	}

	.info-return-home:not(.info-return-ready) main {
		visibility: hidden;
	}

	.case-return-home:not(.case-return-ready) .identity,
	.case-return-home:not(.case-return-ready) nav,
	.case-return-home:not(.case-return-ready) main {
		opacity: 0;
	}

	.c-scrollbar {
		display: none !important;
	}

	html {
		min-width: 1140px;
		height: 100%;
		background: var(--color-background);
		overflow: hidden;
	}

	body {
		height: 100%;
		margin: 0;
		color: var(--color-text);
		background: var(--color-background);
		font-family: 'Onest Variable', Onest, sans-serif;
		font-synthesis: none;
		overflow: hidden;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.page-grid {
		display: grid;
		grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
		column-gap: var(--grid-gap);
		padding-inline: var(--page-padding);
	}

	main {
		grid-column: 4 / span 9;
		min-width: 0;
	}

	@media (max-width: 767px) {
		html,
		body {
			min-width: 0;
			height: auto;
			overflow: auto;
		}

		.page-grid {
			display: flex;
			width: 100%;
			padding: 0;
			flex-direction: column;
		}

		main {
			width: 100%;
			padding: 16px;
			border-top: 1px solid rgb(25 25 28 / 8%);
		}

		.mobile-layout .site-preloader {
			display: none !important;
		}
	}
</style>
