---
import '@fontsource-variable/onest';
import * as fontkit from 'fontkit';
import { fileURLToPath } from 'node:url';
import ClientRouting from '../components/ClientRouting.astro';
import SiteSidebar from '../components/SiteSidebar.astro';
import TypeScale from '../components/TypeScale.astro';

const contacts = [
	{ label: 'Telegram', href: 'https://t.me/owdesy', group: 3 },
	{ label: 'Max', href: 'https://max.ru/owdesy', group: 1 },
	{ label: 'Dprofile', href: 'https://dprofile.ru/owdesy', group: 2 },
];
const phone = { label: '8 (999) 693-0-693', href: 'tel:+79996930693', group: 0 };
const physicsContacts = [phone, contacts[1], contacts[2], contacts[0]];
const fontPath = fileURLToPath(import.meta.resolve('@fontsource-variable/onest/files/onest-latin-wght-normal.woff2'));
const baseFont = fontkit.openSync(fontPath);
const contactFont = baseFont;
const flattenGlyph = (commands: Array<{ command: string; args: number[] }>) => {
	const contours: Array<Array<{ x: number; y: number }>> = [];
	let contour: Array<{ x: number; y: number }> = [];
	let current = { x: 0, y: 0 };
	const finish = () => {
		if (contour.length >= 3) contours.push(contour);
		contour = [];
	};
	commands.forEach(({ command, args }) => {
		if (command === 'moveTo') {
			finish();
			current = { x: args[0], y: args[1] };
			contour.push({ ...current });
		} else if (command === 'lineTo') {
			current = { x: args[0], y: args[1] };
			contour.push({ ...current });
		} else if (command === 'quadraticCurveTo') {
			const start = { ...current };
			const control = { x: args[0], y: args[1] };
			const end = { x: args[2], y: args[3] };
			for (let step = 1; step <= 6; step += 1) {
				const t = step / 6;
				const inverse = 1 - t;
				contour.push({
					x: inverse * inverse * start.x + 2 * inverse * t * control.x + t * t * end.x,
					y: inverse * inverse * start.y + 2 * inverse * t * control.y + t * t * end.y,
				});
			}
			current = end;
		} else if (command === 'bezierCurveTo') {
			const start = { ...current };
			const first = { x: args[0], y: args[1] };
			const second = { x: args[2], y: args[3] };
			const end = { x: args[4], y: args[5] };
			for (let step = 1; step <= 8; step += 1) {
				const t = step / 8;
				const inverse = 1 - t;
				contour.push({
					x: inverse ** 3 * start.x + 3 * inverse ** 2 * t * first.x + 3 * inverse * t ** 2 * second.x + t ** 3 * end.x,
					y: inverse ** 3 * start.y + 3 * inverse ** 2 * t * first.y + 3 * inverse * t ** 2 * second.y + t ** 3 * end.y,
				});
			}
			current = end;
		} else if (command === 'closePath') finish();
	});
	finish();
	return contours;
};
const physicsLetters = physicsContacts.flatMap((contact, group) => [...contact.label].flatMap((character, index) => {
	if (character === ' ') return [];
	const glyph = contactFont.glyphForCodePoint(character.codePointAt(0) ?? 0);
	const { minX, minY, maxX, maxY } = glyph.bbox;
	return [{
		contact,
		group,
		index,
		character,
		path: glyph.path.toSVG(),
		vertices: flattenGlyph(glyph.path.commands),
		minX,
		minY,
		maxX,
		maxY,
		width: Math.max(1, maxX - minX),
		height: Math.max(1, maxY - minY),
		unitsPerEm: contactFont.unitsPerEm,
	}];
}));
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<ClientRouting />
		<style is:inline>html,body{margin:0;background:#fff}</style>
		<script is:inline>
			if (window.matchMedia('(max-width: 767px)').matches) window.location.replace('/mobile');
		</script>
		<script is:inline data-astro-rerun>
			var internalContactsTransition = false;
			try {
				internalContactsTransition = sessionStorage.getItem('contacts-page-transition') === 'true';
				sessionStorage.removeItem('contacts-page-transition');
			} catch {}
			document.documentElement.classList.toggle('contacts-direct', !internalContactsTransition);
			document.documentElement.classList.add('contacts-entering');
		</script>
		<TypeScale />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="description" content="Контакты Олега Кротова — digital designer." />
		<title>Контакты — Олег Кротов</title>
	</head>
	<body>
		<div class="page-grid">
			<SiteSidebar active="contacts" />
			<main>
				<div class="contact-physics" data-contact-physics>
					{physicsLetters.map((letter) => (
							<a
								class="contact-body"
								href={letter.contact.href}
								target={letter.contact.href.startsWith('http') ? '_blank' : undefined}
								rel={letter.contact.href.startsWith('http') ? 'noreferrer' : undefined}
								aria-label={letter.contact.label}
								data-group={letter.group}
								data-index={letter.index}
								data-glyph-vertices={JSON.stringify(letter.vertices)}
								data-glyph-units={letter.unitsPerEm}
								style={`--glyph-width:${letter.width};--glyph-height:${letter.height};--glyph-units:${letter.unitsPerEm}`}
							>
								<svg viewBox={`${letter.minX} ${-letter.maxY} ${letter.width} ${letter.height}`} aria-hidden="true">
									<g transform="scale(1 -1)"><path d={letter.path} /></g>
								</svg>
							</a>
					))}
				</div>
				<div class="contact-footer" data-contact-footer>
					<div class="contact-footer__socials">
						{contacts.map((contact, index) => (
							<>
								<a href={contact.href} target="_blank" rel="noreferrer" data-contact-link data-contact-group={contact.group} data-value={contact.label}>{contact.label}</a>
								{index < contacts.length - 1 && <span class="contact-dot" aria-hidden="true">·</span>}
							</>
						))}
					</div>
					<a href={phone.href} data-contact-link data-contact-group={phone.group} data-value={phone.label}>{phone.label}</a>
				</div>
			</main>
		</div>

		<script>
			import { navigate } from 'astro:transitions/client';
			import { Body as MatterBody, Bodies, Composite, Engine, Query, Vertices } from 'matter-js';

			let cleanupContacts = () => {};
			let isReturningHome = false;
			const initializeContacts = () => {
				cleanupContacts();
				isReturningHome = false;
				const controller = new AbortController();
				const stage = document.querySelector<HTMLElement>('[data-contact-physics]');
				const footer = document.querySelector<HTMLElement>('[data-contact-footer]');
				if (!stage || !footer) return;
				const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const links = [...footer.querySelectorAll<HTMLAnchorElement>('[data-contact-link]')];
				const alphabet = [...new Set(links.flatMap((link) => [...(link.dataset.value ?? '')]).filter((char) => char !== ' '))];
				links.forEach((link) => {
					const value = link.dataset.value ?? '';
					link.textContent = '';
					[...value].forEach((character) => {
						const span = document.createElement('span');
						span.className = 'contact-link-char';
						span.dataset.character = character;
						span.textContent = '';
						link.append(span);
					});
				});

				const scrambleIn = () => links.forEach((link, linkIndex) => {
					const spans = [...link.querySelectorAll<HTMLElement>('.contact-link-char')];
					spans.forEach((span, index) => window.setTimeout(() => {
						const target = span.dataset.character ?? '';
						const started = performance.now();
						const duration = 260 + Math.random() * 280;
						const frame = (now: number) => {
							const progress = Math.min(1, (now - started) / duration);
							span.textContent = target === ' ' ? '\u00a0' : progress === 1
								? target
								: alphabet[Math.floor(Math.random() * alphabet.length)] ?? target;
							if (progress < 1) window.setTimeout(() => requestAnimationFrame(frame), 36);
						};
						requestAnimationFrame(frame);
					}, linkIndex * 100 + index * 34));
				});
				const scrambleOut = () => Promise.all(links.map((link, linkIndex) => {
					const spans = [...link.querySelectorAll<HTMLElement>('.contact-link-char')];
					return Promise.all([...spans].reverse().map((span, reverseIndex) => new Promise<void>((resolve) => {
						window.setTimeout(() => {
							const target = span.dataset.character ?? '';
							if (target === ' ') {
								span.textContent = '';
								resolve();
								return;
							}
							const started = performance.now();
							const duration = 150 + Math.random() * 150;
							const frame = (now: number) => {
								const progress = Math.min(1, (now - started) / duration);
								span.textContent = progress === 1
									? ''
									: alphabet[Math.floor(Math.random() * alphabet.length)] ?? target;
								if (progress < 1) window.setTimeout(() => requestAnimationFrame(frame), 32);
								else resolve();
							};
							requestAnimationFrame(frame);
						}, linkIndex * 42 + reverseIndex * 18);
					}))).then(() => undefined);
				})).then(() => footer.classList.remove('is-visible'));
				const lockedCharacters = new Set([' ', '+', '(', ')', '-', '–', '—']);
				const scrambleHover = (link: HTMLAnchorElement) => {
					if (reduced || leaving || link.dataset.hoverAnimating === 'true') return;
					const original = [...(link.dataset.value ?? '')];
					const spans = [...link.querySelectorAll<HTMLElement>('.contact-link-char')];
					const indexes = original.flatMap((character, index) => lockedCharacters.has(character) ? [] : [index]);
					const characters = indexes.map((index) => original[index]);
					link.dataset.hoverAnimating = 'true';
					const started = performance.now();
					let nextTick = started;
					const frame = (now: number) => {
						const progress = Math.min(1, (now - started) / 260);
						if (now >= nextTick) {
							nextTick = now + 38 + 38 * (1 - Math.pow(1 - progress, 3));
							const shuffled = [...characters];
							for (let index = shuffled.length - 1; index > 0; index -= 1) {
								const target = Math.floor(Math.random() * (index + 1));
								[shuffled[index], shuffled[target]] = [shuffled[target], shuffled[index]];
							}
							indexes.forEach((characterIndex, index) => { spans[characterIndex].textContent = shuffled[index] ?? ''; });
						}
						if (progress < 1) requestAnimationFrame(frame);
						else {
							spans.forEach((span, index) => { span.textContent = original[index] === ' ' ? '\u00a0' : original[index] ?? ''; });
							link.dataset.hoverAnimating = 'false';
						}
					};
					requestAnimationFrame(frame);
				};
				links.forEach((link) => {
					link.addEventListener('pointerenter', () => scrambleHover(link), { signal: controller.signal });
					link.addEventListener('focus', () => scrambleHover(link), { signal: controller.signal });
				});
				const setHighlightedGroup = (group?: string) => {
					stage.querySelectorAll<HTMLElement>('.contact-body').forEach((letter) => {
						letter.classList.toggle('is-muted', group !== undefined && letter.dataset.group !== group);
					});
				};
				links.forEach((link) => {
					link.addEventListener('pointerenter', () => setHighlightedGroup(link.dataset.contactGroup), { signal: controller.signal });
					link.addEventListener('pointerleave', () => setHighlightedGroup(), { signal: controller.signal });
					link.addEventListener('focus', () => setHighlightedGroup(link.dataset.contactGroup), { signal: controller.signal });
					link.addEventListener('blur', () => setHighlightedGroup(), { signal: controller.signal });
				});
				stage.addEventListener('focusin', (event) => {
					const letter = (event.target as HTMLElement).closest<HTMLElement>('.contact-body');
					if (letter) setHighlightedGroup(letter.dataset.group);
				}, { signal: controller.signal });
				stage.addEventListener('focusout', () => setHighlightedGroup(), { signal: controller.signal });

				type LetterBody = { el: HTMLElement; body: Matter.Body; w: number; h: number; offsetX: number; offsetY: number; entered: boolean };
				const engine = Engine.create({ positionIterations: 16, velocityIterations: 10, constraintIterations: 4 });
				engine.gravity.y = 1.15;
				engine.gravity.scale = .001;
				let bodies: LetterBody[] = [];
				let walls: Matter.Body[] = [];
				let frameId = 0;
				let last = performance.now();
				let physicsAccumulator = 0;
				let dragging: { item: LetterBody; id: number; dx: number; dy: number; lx: number; ly: number; time: number; moved: boolean } | null = null;
				let suppressBodyClickUntil = 0;

				const buildPhysics = () => {
					const bounds = stage.getBoundingClientRect();
					const elements = [...stage.querySelectorAll<HTMLElement>('.contact-body')];
					const wallSize = 120;
					walls = [
						Bodies.rectangle(-wallSize / 2, bounds.height / 2, wallSize, bounds.height * 4, { isStatic: true }),
						Bodies.rectangle(bounds.width + wallSize / 2, bounds.height / 2, wallSize, bounds.height * 4, { isStatic: true }),
						Bodies.rectangle(bounds.width / 2, bounds.height + wallSize / 2, bounds.width + wallSize * 2, wallSize, { isStatic: true }),
						Bodies.rectangle(bounds.width / 2, -wallSize / 2, bounds.width + wallSize * 2, wallSize, {
							isStatic: true,
							collisionFilter: { category: 0x0002, mask: 0x0001 },
						}),
					];
					bodies = elements.map((el, order) => {
						const rect = el.getBoundingClientRect();
						const group = Number(el.dataset.group) || 0;
						const groupCenters = [.48, .24, .63, .3];
						const groupOffsets = [order * 2.2, order * 4.1, order * 3.5, order * 3.8];
						const x = bounds.width * groupCenters[group] + groupOffsets[group] + (Math.random() - .5) * 110;
						const y = -bounds.height * (.2 + Math.random() * 1.35) - order * 12;
						const vertexSets = JSON.parse(el.dataset.glyphVertices ?? '[]') as Array<Array<{ x: number; y: number }>>;
						const rawVertices = vertexSets.flat();
						const rawMinX = Math.min(...rawVertices.map((point) => point.x));
						const rawMaxX = Math.max(...rawVertices.map((point) => point.x));
						const rawMinY = Math.min(...rawVertices.map((point) => point.y));
						const rawMaxY = Math.max(...rawVertices.map((point) => point.y));
						const rawWidth = Math.max(1, rawMaxX - rawMinX);
						const rawHeight = Math.max(1, rawMaxY - rawMinY);
						const fontSize = parseFloat(getComputedStyle(el).fontSize);
						const glyphUnits = Number(el.dataset.glyphUnits) || 1000;
						const collisionExpansion = 6 + 14 * fontSize / glyphUnits;
						const collisionWidth = rect.width + collisionExpansion;
						const collisionHeight = rect.height + collisionExpansion;
						const outline = rawVertices.map((point) => ({
							x: (point.x - (rawMinX + rawMaxX) / 2) * collisionWidth / rawWidth,
							y: -(point.y - (rawMinY + rawMaxY) / 2) * collisionHeight / rawHeight,
						}));
						const hull = outline.length >= 3 ? Vertices.hull(outline) : [];
						const options = {
							restitution: .42,
							friction: .18,
							frictionStatic: .32,
							frictionAir: .006,
							density: .0018,
							slop: .001,
							collisionFilter: { category: 0x0001, mask: 0xFFFFFFFD },
						};
						const body = hull.length >= 3
							? Bodies.fromVertices(x, y, hull, options, false)
							: Bodies.rectangle(x, y, rect.width * .8, rect.height * .76, options);
						const offsetX = (body.bounds.min.x + body.bounds.max.x) / 2 - body.position.x;
						const offsetY = (body.bounds.min.y + body.bounds.max.y) / 2 - body.position.y;
						MatterBody.setAngle(body, (Math.random() - .5) * 1.05);
						MatterBody.setVelocity(body, { x: (Math.random() - .5) * 7, y: 1 + Math.random() * 3 });
						MatterBody.setAngularVelocity(body, (Math.random() - .5) * .095);
						return { el, body, w: rect.width, h: rect.height, offsetX, offsetY, entered: false };
					});
					Composite.add(engine.world, [...walls, ...bodies.map((item) => item.body)]);
				};

				const renderBody = (item: LetterBody) => {
					const cosine = Math.cos(item.body.angle);
					const sine = Math.sin(item.body.angle);
					const centerX = item.body.position.x + item.offsetX * cosine - item.offsetY * sine;
					const centerY = item.body.position.y + item.offsetX * sine + item.offsetY * cosine;
					item.el.style.transform = `translate3d(${centerX - item.w / 2}px, ${centerY - item.h / 2}px, 0) rotate(${item.body.angle}rad)`;
				};
				const bodyAtPointer = (event: PointerEvent) => {
					const rect = stage.getBoundingClientRect();
					const point = { x: event.clientX - rect.left, y: event.clientY - rect.top };
					const hit = Query.point(bodies.map((item) => item.body), point).at(-1);
					return bodies.find((item) => item.body === hit);
				};
				const tick = (now: number) => {
					const delta = Math.min(50, now - last);
					last = now;
					physicsAccumulator += delta;
					while (physicsAccumulator >= 1000 / 60) {
						Engine.update(engine, 1000 / 60);
						physicsAccumulator -= 1000 / 60;
					}
					bodies.forEach((item) => {
						if (!item.entered && item.body.position.y >= item.h / 2) {
							item.entered = true;
							item.body.collisionFilter.mask = 0xFFFFFFFF;
						}
					});
					bodies.forEach(renderBody);
					frameId = requestAnimationFrame(tick);
				};

				stage.addEventListener('pointerdown', (event) => {
					const item = bodyAtPointer(event);
					if (!item || leaving) return;
					const rect = stage.getBoundingClientRect();
					dragging = { item, id: event.pointerId, dx: event.clientX - rect.left - item.body.position.x, dy: event.clientY - rect.top - item.body.position.y, lx: event.clientX, ly: event.clientY, time: performance.now(), moved: false };
					MatterBody.setStatic(item.body, true);
					stage.setPointerCapture(event.pointerId);
					item.el.classList.add('is-dragging');
				}, { signal: controller.signal });
				stage.addEventListener('pointermove', (event) => {
					if (!dragging || dragging.id !== event.pointerId) {
						const hovered = bodyAtPointer(event);
						stage.classList.toggle('has-letter-hover', Boolean(hovered));
						setHighlightedGroup(hovered?.el.dataset.group);
						return;
					}
					const rect = stage.getBoundingClientRect();
					const now = performance.now();
					const elapsed = Math.max(1, now - dragging.time);
					const item = dragging.item;
					if (Math.abs(event.clientX - dragging.lx) + Math.abs(event.clientY - dragging.ly) > 3) dragging.moved = true;
					const x = Math.max(item.w / 2, Math.min(stage.clientWidth - item.w / 2, event.clientX - rect.left - dragging.dx));
					const y = Math.max(item.h / 2, Math.min(stage.clientHeight - item.h / 2, event.clientY - rect.top - dragging.dy));
					MatterBody.setPosition(item.body, { x, y });
					MatterBody.setVelocity(item.body, { x: (event.clientX - dragging.lx) / elapsed * 16.67, y: (event.clientY - dragging.ly) / elapsed * 16.67 });
					dragging.lx = event.clientX; dragging.ly = event.clientY; dragging.time = now;
					renderBody(item);
				}, { signal: controller.signal });
				const drop = (event: PointerEvent, activate = false) => {
					if (!dragging || dragging.id !== event.pointerId) return;
					const { item } = dragging;
					const shouldActivate = activate && !dragging.moved;
					item.el.classList.remove('is-dragging');
					MatterBody.setStatic(item.body, false);
					if (dragging.moved) suppressBodyClickUntil = performance.now() + 350;
					dragging = null;
					if (shouldActivate) item.el.click();
				};
				stage.addEventListener('pointerup', (event) => drop(event, true), { signal: controller.signal });
				stage.addEventListener('pointercancel', (event) => drop(event), { signal: controller.signal });
				stage.addEventListener('pointerleave', () => {
					if (dragging) return;
					stage.classList.remove('has-letter-hover');
					setHighlightedGroup();
				}, { signal: controller.signal });
				stage.addEventListener('click', (event) => {
					if (performance.now() < suppressBodyClickUntil) {
						event.preventDefault();
						event.stopPropagation();
					}
				}, { capture: true, signal: controller.signal });

				const enter = () => {
					footer.classList.add('is-visible');
					if (reduced) {
						links.forEach((link) => [...link.querySelectorAll<HTMLElement>('.contact-link-char')].forEach((span) => { span.textContent = span.dataset.character === ' ' ? '\u00a0' : span.dataset.character ?? ''; }));
					}
					else scrambleIn();
					buildPhysics();
					if (reduced) bodies.forEach((item, index) => {
						MatterBody.setPosition(item.body, {
							x: item.w / 2 + (index * item.w * .72) % Math.max(item.w, stage.clientWidth - item.w),
							y: stage.clientHeight - item.h / 2,
						});
						renderBody(item);
					});
					else frameId = requestAnimationFrame(tick);
				};
				requestAnimationFrame(enter);

				let leaving = false;
				const dropBodies = () => new Promise<void>((resolve) => {
					stage.classList.add('is-leaving');
					if (reduced) {
						bodies.forEach((item) => {
							MatterBody.setPosition(item.body, { x: item.body.position.x, y: window.innerHeight + item.h });
							renderBody(item);
						});
						resolve();
						return;
					}
					if (dragging) {
						dragging.item.el.classList.remove('is-dragging');
						MatterBody.setStatic(dragging.item.body, false);
						dragging = null;
					}
					const bounds = stage.getBoundingClientRect();
					const floor = walls[2];
					if (floor) Composite.remove(engine.world, floor);
					const funnelGap = Math.max(150, Math.min(240, bounds.width * .12));
					const funnelRun = (bounds.width - funnelGap) / 2;
					const funnelAngle = Math.atan2(Math.min(78, bounds.height * .09), funnelRun);
					const funnelLength = funnelRun / Math.cos(funnelAngle) + 20;
					const funnelThickness = 90;
					const funnelDrop = Math.tan(funnelAngle) * funnelRun;
					const funnelOptions = { isStatic: true, friction: .12, frictionStatic: .18, restitution: .18 };
					const funnel = [
						Bodies.rectangle(funnelRun / 2, bounds.height + funnelDrop / 2 + funnelThickness / 2, funnelLength, funnelThickness, { ...funnelOptions, angle: funnelAngle }),
						Bodies.rectangle(bounds.width - funnelRun / 2, bounds.height + funnelDrop / 2 + funnelThickness / 2, funnelLength, funnelThickness, { ...funnelOptions, angle: -funnelAngle }),
					];
					Composite.add(engine.world, funnel);
					engine.gravity.y = 1.18;
					bodies.forEach((item) => {
						MatterBody.setVelocity(item.body, {
							x: item.body.velocity.x * .45 + (Math.random() - .5) * 1.4,
							y: Math.max(.8, item.body.velocity.y * .15 + Math.random() * 1.2),
						});
						MatterBody.setAngularVelocity(item.body, item.body.angularVelocity + (Math.random() - .5) * .035);
					});
					setTimeout(() => {
						funnel.forEach((part) => Composite.remove(engine.world, part));
						walls.filter((wall) => wall !== floor).forEach((wall) => Composite.remove(engine.world, wall));
						engine.gravity.y = 1.55;
					}, 820);
					const waitUntilGone = () => {
						if (bodies.every((item) => item.body.position.y - item.h / 2 > window.innerHeight)) resolve();
						else requestAnimationFrame(waitUntilGone);
					};
					requestAnimationFrame(waitUntilGone);
				});
				document.querySelectorAll<HTMLAnchorElement>('.sidebar a[href]').forEach((link) => {
					const destination = new URL(link.href, location.href);
					if (destination.origin !== location.origin || destination.pathname === '/contacts') return;
					link.addEventListener('click', async (event) => {
						event.preventDefault();
						if (leaving) return;
						leaving = true;
						if (destination.pathname === '/') {
							isReturningHome = true;
							try { sessionStorage.setItem('info-return-home', 'true'); } catch {}
							destination.searchParams.set('info-return', Date.now().toString());
						} else if (destination.pathname === '/info') {
							try { sessionStorage.setItem('info-page-transition', 'true'); } catch {}
						}
						await Promise.all([scrambleOut(), dropBodies()]);
						void navigate(destination.href);
					}, { signal: controller.signal });
				});
				cleanupContacts = () => {
					controller.abort();
					cancelAnimationFrame(frameId);
					Composite.clear(engine.world, false, true);
					Engine.clear(engine);
				};
			};
			document.addEventListener('astro:page-load', initializeContacts);
			document.addEventListener('astro:before-swap', (event) => {
				if (isReturningHome) {
					const swapEvent = event as Event & { newDocument?: Document };
					const incomingDocument = swapEvent.newDocument;
					if (incomingDocument) {
						incomingDocument.documentElement.classList.remove('is-preloading');
						incomingDocument.documentElement.classList.add('info-return-home');
						incomingDocument.querySelector('[data-site-preloader]')?.remove();
					}
				}
				cleanupContacts();
			});
		</script>
	</body>
</html>

