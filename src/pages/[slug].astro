---
import '@fontsource-variable/onest';
import type { GetStaticPaths } from 'astro';
import type { Project } from '../data/projects';
import { projects } from '../data/projects';

export const getStaticPaths = (() => projects
	.filter((project) => project.gallery?.length)
	.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
	project: Project;
}

const { project } = Astro.props;
const gallery = project.gallery ?? [];
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={`${project.title} — ${project.category}. Проект Олега Кротова.`} />
		<title>{project.title} — Олег Кротов</title>
	</head>
	<body>
		<main class="case-page">
			<header class="case-header">
				<div class="case-header__meta">
					<strong>{project.title}</strong>
					<span class="case-header__separator" aria-hidden="true">·</span>
					<span>{project.caseDescription}</span>
				</div>
				<a href="/">Закрыть</a>
			</header>
			<div
				class="case-page__viewport"
				data-case-viewport
				tabindex="0"
				aria-label={`Проект ${project.title}`}
			>
				<div class="case-page__content" data-case-content>
					{gallery.map((image, index) => (
						<img
							src={image}
							alt={`${project.title} — изображение ${index + 1}`}
							loading={index < 2 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					))}
				</div>
			</div>
		</main>
		<script>
			import Lenis from 'lenis';

			const viewport = document.querySelector<HTMLElement>('[data-case-viewport]');
			const content = document.querySelector<HTMLElement>('[data-case-content]');
			if (viewport && content) {
				new Lenis({
					wrapper: viewport,
					content,
					eventsTarget: viewport,
					smoothWheel: true,
					syncTouch: true,
					lerp: 0.1,
					autoResize: true,
					autoRaf: true,
					overscroll: false,
				});
			}
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
		scrollbar-width: none;
	}

	:global(*::-webkit-scrollbar) {
		display: none;
		width: 0;
		height: 0;
	}

	:global(html),
	:global(body) {
		min-width: 0;
		height: 100%;
		margin: 0;
		overflow: hidden;
		background: #fff;
		font-family: 'Onest Variable', Onest, sans-serif;
	}

	.case-page {
		display: flex;
		width: 100%;
		height: 100dvh;
		padding: 40px;
		flex-direction: column;
		gap: 24px;
		background: #fff;
	}

	.case-header {
		display: flex;
		width: 100%;
		flex: none;
		align-items: flex-start;
		justify-content: space-between;
		color: #19191c;
		font-size: 20px;
		font-weight: 400;
		line-height: 24px;
	}

	.case-header__meta {
		display: flex;
		align-items: flex-end;
		gap: 12px;
	}

	.case-header strong {
		font-weight: 400;
	}

	.case-header__meta > span {
		color: rgb(25 25 28 / 60%);
	}

	.case-header a {
		color: inherit;
		text-decoration: none;
	}

	.case-page__viewport {
		width: 100%;
		min-height: 0;
		flex: 1;
		margin-inline: auto;
		overflow: auto;
		border-radius: 3px;
		border: 1px solid rgb(25 25 28 / 12%);
		background: #fff;
		overscroll-behavior: contain;
		outline: none;
	}

	.case-page__content {
		width: 100%;
		min-height: 100%;
		margin-inline: auto;
		background: #fff;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
