---
import '@fontsource-variable/onest';
import type { GetStaticPaths } from 'astro';
import type { Project } from '../data/projects';
import { projects } from '../data/projects';
import { detectCaseBackground } from '../utils/case-background';

export const getStaticPaths = (() => projects
	.filter((project) => project.gallery?.length)
	.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
	project: Project;
}

const { project } = Astro.props;
const gallery = project.gallery ?? [];
const lastImage = gallery.at(-1);
const caseBackground = lastImage ? await detectCaseBackground(lastImage) : '#fff';
---

<!doctype html>
<html lang="ru" style={`--case-background: ${caseBackground}`}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={`${project.title} — ${project.category}. Проект Олега Кротова.`} />
		<title>{project.title} — Олег Кротов</title>
	</head>
	<body>
		<main class="case-page">
			<div
				class:list={['case-page__viewport', { 'is-light': caseBackground === '#fff' }]}
				data-case-viewport
				tabindex="0"
				aria-label={`Проект ${project.title}`}
			>
				<div class="case-page__content" data-case-content>
					{gallery.map((image, index) => (
						<img
							src={image}
							alt={`${project.title} — изображение ${index + 1}`}
							loading={index < 2 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					))}
				</div>
			</div>
		</main>
		<script>
			import Lenis from 'lenis';

			const viewport = document.querySelector<HTMLElement>('[data-case-viewport]');
			const content = document.querySelector<HTMLElement>('[data-case-content]');
			if (viewport && content) {
				new Lenis({
					wrapper: viewport,
					content,
					eventsTarget: viewport,
					smoothWheel: true,
					syncTouch: true,
					lerp: 0.1,
					autoResize: true,
					autoRaf: true,
					overscroll: false,
				});
			}
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
		scrollbar-width: none;
	}

	:global(*::-webkit-scrollbar) {
		display: none;
		width: 0;
		height: 0;
	}

	:global(html),
	:global(body) {
		min-width: 0;
		height: 100%;
		margin: 0;
		overflow: hidden;
		background: #fff;
	}

	.case-page {
		width: 100%;
		height: 100dvh;
		padding: 40px;
		background: #fff;
	}

	.case-page__viewport {
		width: 100%;
		height: 100%;
		margin-inline: auto;
		overflow: auto;
		border-radius: 3px;
		background: var(--case-background);
		overscroll-behavior: contain;
		outline: none;
	}

	.case-page__viewport.is-light {
		border: 1px solid #eaeaeb;
	}

	.case-page__content {
		width: min(1600px, 100%);
		min-height: 100%;
		margin-inline: auto;
		background: var(--case-background);
	}

	img {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
