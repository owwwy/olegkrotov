---
import '@fontsource-variable/onest';
import type { GetStaticPaths } from 'astro';
import TypeScale from '../components/TypeScale.astro';
import SeoHead from '../components/SeoHead.astro';
import type { Project } from '../data/projects';
import { projects } from '../data/projects';

export const getStaticPaths = (() => projects
	.filter((project) => project.gallery?.length)
	.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
	project: Project;
}

const { project } = Astro.props;
const gallery = project.gallery ?? [];
const animatedImages = new Set([
	'/projects/busa/03.webp',
	'/projects/jetsite/2.webp',
	'/projects/jetsite/4.webp',
	'/projects/jetsite/7.webp',
	'/projects/jetsite/10.webp',
	'/projects/jetsite/12.webp',
	'/projects/jetsite/15.webp',
	'/projects/jetsite/17.webp',
	'/projects/jetsite/19.webp',
	'/projects/jetsite/24.webp',
	'/projects/podryado/02.webp',
	'/projects/podryado/28.webp',
	'/projects/s-industrial-case/10.webp',
	'/projects/s-industrial-case/12.webp',
]);
const animatedVideos = new Set([
	'/projects/podryado/15.webm',
]);
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, viewport-fit=cover" />
		<script is:inline>
			if (new URLSearchParams(window.location.search).has('entry')) {
				window.history.replaceState(window.history.state, '', window.location.pathname);
			}
			try {
				if (sessionStorage.getItem('case-page-transition') === 'true') {
					document.documentElement.classList.add('case-entering');
					sessionStorage.removeItem('case-page-transition');
				}
			} catch {}
		</script>
		<TypeScale />
		{projects.map((item) => <link rel="preload" as="image" href={item.image} />)}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#ffffff" data-case-theme-color />
		<SeoHead
			title={`${project.title} — проект Олега Кротова`}
			description={`${project.title} — ${project.category}. Проект digital designer Олега Кротова.`}
			path={`/${project.slug}`}
			image={project.image}
			type="article"
			project={{ name: project.title, description: project.category, image: project.image }}
		/>
	</head>
	<body>
		<main class:list={['case-page', { 'case-page--dark-content': project.slug === 'podryado' }]}>
			<header class="case-header">
				<div class="case-header__meta">
					<strong data-case-reveal data-value={project.title}>
						{[...project.title].map((character) => <span>{character === ' ' ? '\u00a0' : character}</span>)}
					</strong>
					<span class="case-header__separator" aria-hidden="true">·</span>
					<span data-case-reveal data-value={project.caseDescription}>
						{[...project.caseDescription].map((character) => <span>{character === ' ' ? '\u00a0' : character}</span>)}
					</span>
					<span class="case-header__separator" aria-hidden="true">·</span>
					<a class="case-header__website" href={`https://${project.website}`} target="_blank" rel="noreferrer" data-case-scramble data-case-reveal data-value={project.website}>
						{[...project.website].map((character) => <span>{character}</span>)}
					</a>
				</div>
				<a class="case-header__close" href="/" data-case-scramble data-case-reveal data-value="Закрыть">
					{[...'Закрыть'].map((character) => <span>{character}</span>)}
				</a>
			</header>
			<div class="case-page__layout">
				<aside class="case-minimap" aria-hidden="true">
					<div class="case-minimap__track" data-case-minimap-track>
						<div class="case-minimap__strip" data-case-minimap-strip>
							{gallery.map((image) => {
								const isAnimated = animatedImages.has(image);
								const isVideo = animatedVideos.has(image);
								const poster = isVideo
									? image.replace(/\.webm$/, '.poster.webp')
									: isAnimated ? image.replace(/\.webp$/, '.poster.webp') : image;
								const thumbnail = poster.endsWith('.webp')
									? poster.replace('/projects/', '/projects-mobile/')
									: poster;
								return <img src={thumbnail} alt="" loading="lazy" decoding="async" />;
							})}
						</div>
						<div class="case-minimap__shade case-minimap__shade--before" data-case-minimap-before></div>
						<div class="case-minimap__shade case-minimap__shade--after" data-case-minimap-after></div>
					</div>
					<div class="case-minimap__window" data-case-minimap-window></div>
				</aside>
				<div
					class="case-page__viewport"
					data-case-viewport
					tabindex="0"
					aria-label={`Проект ${project.title}`}
				>
					<canvas class="case-page__pixel-reveal" data-case-pixel-reveal aria-hidden="true"></canvas>
					<div class="case-page__content" data-case-content>
						{gallery.map((image, index) => {
							const isAnimated = animatedImages.has(image);
							const isVideo = animatedVideos.has(image);
							const poster = isVideo
								? image.replace(/\.webm$/, '.poster.webp')
								: isAnimated ? image.replace(/\.webp$/, '.poster.webp') : image;
							const mobileImage = image.replace('/projects/', '/projects-mobile/');
							return isVideo ? (
								<video
									poster={poster}
									muted
									autoplay
									loop
									playsinline
									preload="none"
									aria-label={`${project.title} — видео ${index + 1}`}
									data-animated-video-src={image}
								/>
							) : isAnimated ? (
								<img
									src={poster}
									alt={`${project.title} — изображение ${index + 1}`}
									loading={index < 2 ? 'eager' : 'lazy'}
									decoding="async"
									data-animated-src={isAnimated ? image : undefined}
									data-animated-poster={isAnimated ? poster : undefined}
								/>
							) : (
								<picture>
									{image.endsWith('.webp') && <source media="(max-width: 767px)" srcset={mobileImage} />}
									<img
										src={image}
										alt={`${project.title} — изображение ${index + 1}`}
										loading={index < 2 ? 'eager' : 'lazy'}
										decoding="async"
									/>
								</picture>
							);
						})}
					</div>
				</div>
			</div>
		</main>
		<script>
			import Lenis from 'lenis';

			const viewport = document.querySelector<HTMLElement>('[data-case-viewport]');
			const content = document.querySelector<HTMLElement>('[data-case-content]');
			const casePage = document.querySelector<HTMLElement>('.case-page');
			const caseThemeColor = document.querySelector<HTMLMetaElement>('[data-case-theme-color]');
			const mobileCase = window.matchMedia('(max-width: 767px)').matches;
			const minimapTrack = document.querySelector<HTMLElement>('[data-case-minimap-track]');
			const minimapStrip = document.querySelector<HTMLElement>('[data-case-minimap-strip]');
			const minimapWindow = document.querySelector<HTMLElement>('[data-case-minimap-window]');
			const minimapBefore = document.querySelector<HTMLElement>('[data-case-minimap-before]');
			const minimapAfter = document.querySelector<HTMLElement>('[data-case-minimap-after]');
			const mobileCloseLink = document.querySelector<HTMLAnchorElement>('.case-header__close');
			if (mobileCase && mobileCloseLink) {
				mobileCloseLink.href = '/mobile';
				mobileCloseLink.dataset.value = 'Назад';
				mobileCloseLink.replaceChildren(...[...'Назад'].map((character) => {
					const span = document.createElement('span');
					span.textContent = character;
					return span;
				}));
			}
			if (viewport && content) {
				let minimapScale = 1;
				let minimapStripOffset = 0;
				const updateMinimap = (scroll = viewport.scrollTop) => {
					if (!minimapTrack || !minimapStrip || !minimapWindow || !minimapBefore || !minimapAfter) return;
					const scrollHeight = Math.max(viewport.clientHeight, content.scrollHeight);
					const maximumScroll = Math.max(0, scrollHeight - viewport.clientHeight);
					const scale = minimapTrack.clientWidth / Math.max(1, content.clientWidth);
					const stripHeight = Math.max(1, scrollHeight * scale);
					const trackHeight = Math.min(viewport.clientHeight, stripHeight);
					const windowHeight = Math.min(trackHeight, Math.max(24, viewport.clientHeight * scale));
					const position = Math.min(maximumScroll, Math.max(0, scroll)) * scale;
					const stripOffset = stripHeight <= trackHeight
						? 0
						: Math.max(trackHeight - stripHeight, Math.min(0, trackHeight / 2 - position - windowHeight / 2));
					const top = position + stripOffset;
					minimapScale = scale;
					minimapStripOffset = stripOffset;
					minimapTrack.style.height = `${trackHeight}px`;
					minimapStrip.style.height = `${stripHeight}px`;
					minimapStrip.style.transform = `translate3d(0, ${stripOffset}px, 0)`;
					minimapWindow.style.height = `${windowHeight}px`;
					minimapWindow.style.transform = `translate3d(0, ${top}px, 0)`;
					minimapBefore.style.height = `${top}px`;
					minimapAfter.style.top = `${top + windowHeight}px`;
				};
				const contentMedia = [...content.querySelectorAll<HTMLElement>('img, video')];
				document.querySelectorAll<HTMLImageElement>('.case-minimap__strip img').forEach((image, index) => {
					const updateWeight = () => {
						if (image.naturalWidth) {
							image.style.flexGrow = `${image.naturalHeight / image.naturalWidth}`;
							const contentItem = contentMedia[index];
							if (contentItem) contentItem.style.aspectRatio = `${image.naturalWidth} / ${image.naturalHeight}`;
						}
						updateMinimap(viewport.scrollTop);
					};
					if (image.complete) updateWeight();
					else image.addEventListener('load', updateWeight, { once: true });
				});
				if (mobileCase) {
					casePage?.classList.remove('is-header-hidden');
					if (caseThemeColor) caseThemeColor.content = '#ffffff';
				} else {
					const caseScroll = new Lenis({
						wrapper: viewport,
						content,
						eventsTarget: window,
						smoothWheel: true,
						syncTouch: true,
						lerp: 0.16,
						autoResize: true,
						autoRaf: true,
						overscroll: false,
					});
					caseScroll.on('scroll', ({ scroll, direction, velocity }) => {
						updateMinimap(scroll);
						if (!casePage || document.documentElement.classList.contains('case-leaving')) return;
						if (scroll <= 12) {
							casePage.classList.remove('is-header-hidden');
							return;
						}
						if (Math.abs(velocity) < 0.12) return;
						casePage.classList.toggle('is-header-hidden', direction > 0);
					});
					minimapTrack?.addEventListener('click', (event) => {
						caseScroll.resize();
						const bounds = minimapTrack.getBoundingClientRect();
						const pointInStrip = event.clientY - bounds.top - minimapStripOffset;
						const target = pointInStrip / Math.max(0.0001, minimapScale) - viewport.clientHeight / 2;
						caseScroll.scrollTo(Math.max(0, Math.min(caseScroll.limit, target)), {
							duration: 1.05,
							easing: (value: number) => 1 - Math.pow(1 - value, 4),
						});
					});
					window.addEventListener('resize', () => updateMinimap(caseScroll.scroll), { passive: true });
					new ResizeObserver(() => updateMinimap(caseScroll.scroll)).observe(content);
					requestAnimationFrame(() => updateMinimap(0));
				}

				const animatedMedia = [...content.querySelectorAll<HTMLImageElement | HTMLVideoElement>('[data-animated-src], [data-animated-video-src]')];
				const unloadTimers = new WeakMap<HTMLImageElement | HTMLVideoElement, number>();
				const animationObserver = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						const media = entry.target as HTMLImageElement | HTMLVideoElement;
						const pendingUnload = unloadTimers.get(media);
						if (pendingUnload) window.clearTimeout(pendingUnload);
						if (entry.isIntersecting) {
							if (media instanceof HTMLVideoElement) {
								const videoSource = media.dataset.animatedVideoSrc;
								if (videoSource && media.getAttribute('src') !== videoSource) {
									media.src = videoSource;
									media.load();
								}
								void media.play().catch(() => {});
							} else {
								const animatedSource = media.dataset.animatedSrc;
								if (animatedSource && media.getAttribute('src') !== animatedSource) media.src = animatedSource;
							}
							return;
						}
						const timer = window.setTimeout(() => {
							if (media instanceof HTMLVideoElement) {
								media.pause();
								media.removeAttribute('src');
								media.load();
							} else {
								const poster = media.dataset.animatedPoster;
								if (poster && media.getAttribute('src') !== poster) media.src = poster;
							}
						}, 320);
						unloadTimers.set(media, timer);
					});
				}, { root: mobileCase ? null : viewport, rootMargin: '60% 0px', threshold: 0 });
				animatedMedia.forEach((media) => animationObserver.observe(media));
			}

			const shuffle = (values: string[]) => {
				const result = [...values];
				for (let index = result.length - 1; index > 0; index -= 1) {
					const target = Math.floor(Math.random() * (index + 1));
					[result[index], result[target]] = [result[target], result[index]];
				}
				return result;
			};
			document.querySelectorAll<HTMLElement>('[data-case-scramble]').forEach((element) => {
				const run = () => {
					if (element.dataset.animating === 'true') return;
					const original = [...(element.dataset.value ?? '')];
					const spans = [...element.querySelectorAll<HTMLElement>('span')];
					const mutable = original.flatMap((character, index) => character === ' ' ? [] : [index]);
					const characters = mutable.map((index) => original[index]);
					const startedAt = performance.now();
					let lastTick = 0;
					element.dataset.animating = 'true';
					const frame = (now: number) => {
						const progress = Math.min(1, (now - startedAt) / 260);
						if (now - lastTick >= 46 || progress === 1) {
							lastTick = now;
							const shuffled = shuffle(characters);
							mutable.forEach((characterIndex, index) => {
								spans[characterIndex].textContent = shuffled[index];
							});
						}
						if (progress < 1) requestAnimationFrame(frame);
						else {
							spans.forEach((span, index) => { span.textContent = original[index] === ' ' ? '\u00a0' : original[index]; });
							element.dataset.animating = 'false';
						}
					};
					requestAnimationFrame(frame);
				};
				element.addEventListener('pointerenter', run);
				element.addEventListener('focus', run);
				if (mobileCase) element.addEventListener('pointerdown', run, { passive: true });
			});

			if (document.documentElement.classList.contains('case-entering')) {
				const pixelCanvas = document.querySelector<HTMLCanvasElement>('[data-case-pixel-reveal]');
				const firstImage = content?.querySelector<HTMLImageElement>('img');
				const revealElements = [...document.querySelectorAll<HTMLElement>('[data-case-reveal]')];
				const separators = [...document.querySelectorAll<HTMLElement>('.case-header__separator')];
				revealElements.forEach((element) => {
					element.querySelectorAll<HTMLElement>('span').forEach((span) => { span.textContent = ''; });
				});
				document.documentElement.classList.add('case-entry-ready');
				const reveal = (element: HTMLElement) => new Promise<void>((resolve) => {
					const original = [...(element.dataset.value ?? '')];
					const spans = [...element.querySelectorAll<HTMLElement>('span')];
					const pool = [...new Set(original.filter((character) => character !== ' '))];
					const duration = Math.max(260, Math.min(520, original.length * 18));
					const startedAt = performance.now();
					let lastTick = 0;
					const frame = (now: number) => {
						const progress = Math.min(1, (now - startedAt) / duration);
						if (now - lastTick >= 46 || progress === 1) {
							lastTick = now;
							const visible = Math.ceil(original.length * progress);
							spans.forEach((span, index) => {
								if (index >= visible) span.textContent = '';
								else if (original[index] === ' ') span.textContent = '\u00a0';
								else span.textContent = pool[Math.floor(Math.random() * pool.length)] ?? original[index];
							});
						}
						if (progress < 1) requestAnimationFrame(frame);
						else {
							spans.forEach((span, index) => { span.textContent = original[index] === ' ' ? '\u00a0' : original[index]; });
							resolve();
						}
					};
					requestAnimationFrame(frame);
				});
				const revealPixels = async () => {
					if (!pixelCanvas || !viewport || !firstImage) return;
					if (!firstImage.complete) {
						await new Promise<void>((resolve) => {
							firstImage.addEventListener('load', () => resolve(), { once: true });
							firstImage.addEventListener('error', () => resolve(), { once: true });
						});
					}
					if (!firstImage.naturalWidth) return;
					const width = Math.max(1, viewport.clientWidth);
					const height = Math.max(1, viewport.clientHeight);
					const density = 1;
					pixelCanvas.width = Math.round(width * density);
					pixelCanvas.height = Math.round(height * density);
					const context = pixelCanvas.getContext('2d', { alpha: false });
					const buffer = document.createElement('canvas');
					const bufferContext = buffer.getContext('2d', { alpha: false });
					if (!context || !bufferContext) return;
					context.setTransform(density, 0, 0, density, 0, 0);
					context.imageSmoothingEnabled = false;
					const imageRect = firstImage.getBoundingClientRect();
					const imageHeight = imageRect.height;
					const visibleHeight = Math.min(height, imageHeight);
					const sourceHeight = firstImage.naturalHeight * (visibleHeight / imageHeight);
					const startedAt = performance.now();
					const duration = 900;
					const frame = (now: number) => {
						const progress = Math.min(1, (now - startedAt) / duration);
						const resolutionProgress = progress * progress * (3 - 2 * progress);
						const maximumPixelWidth = Math.min(320, width);
						const pixelWidth = Math.max(6, Math.round(6 + (maximumPixelWidth - 6) * resolutionProgress));
						const pixelHeight = Math.max(1, Math.round(pixelWidth * visibleHeight / width));
						buffer.width = pixelWidth;
						buffer.height = pixelHeight;
						bufferContext.imageSmoothingEnabled = true;
						bufferContext.drawImage(
							firstImage,
							0, 0, firstImage.naturalWidth, sourceHeight,
							0, 0, pixelWidth, pixelHeight,
						);
						context.fillStyle = '#fff';
						context.fillRect(0, 0, width, height);
						context.drawImage(buffer, 0, 0, pixelWidth, pixelHeight, 0, 0, width, visibleHeight);
						const fadeProgress = Math.max(0, Math.min(1, (progress - 0.68) / 0.32));
						const faded = fadeProgress * fadeProgress * (3 - 2 * fadeProgress);
						pixelCanvas.style.opacity = `${1 - faded}`;
						if (progress < 1) requestAnimationFrame(frame);
						else {
							pixelCanvas.classList.add('is-finished');
							window.setTimeout(() => pixelCanvas.remove(), 220);
						}
					};
					requestAnimationFrame(frame);
				};
				requestAnimationFrame(() => requestAnimationFrame(() => {
					document.documentElement.classList.add('case-revealing');
				}));
				revealPixels();
				(async () => {
					await reveal(revealElements[0]);
					separators[0]?.classList.add('is-visible');
					await reveal(revealElements[1]);
					separators[1]?.classList.add('is-visible');
					await reveal(revealElements[2]);
					await reveal(revealElements[3]);
					document.documentElement.classList.remove('case-entering', 'case-revealing', 'case-entry-ready');
				})();
			}

			const closeLink = document.querySelector<HTMLAnchorElement>('.case-header__close');
			if (closeLink && mobileCase) closeLink.href = '/mobile';
			let isLeaving = false;
			const leaveCase = () => new Promise<void>((resolve) => {
				if (isLeaving) {
					resolve();
					return;
				}
				isLeaving = true;
				try { sessionStorage.setItem('case-return-home', 'true'); } catch {}
				document.documentElement.classList.add('case-leaving');

				const exitCanvas = document.createElement('canvas');
				exitCanvas.className = 'case-page__pixel-exit';
				exitCanvas.setAttribute('aria-hidden', 'true');
				const viewportBounds = viewport?.getBoundingClientRect();
				const width = Math.max(1, viewport?.clientWidth ?? 1);
				const height = Math.max(1, viewport?.clientHeight ?? 1);
				exitCanvas.width = width;
				exitCanvas.height = height;
				exitCanvas.style.cssText = `position:fixed;z-index:100;left:${viewportBounds?.left ?? 0}px;top:${viewportBounds?.top ?? 0}px;width:${viewportBounds?.width ?? width}px;height:${viewportBounds?.height ?? height}px;border-radius:3px;background:#fff;pointer-events:none`;
				const exitContext = exitCanvas.getContext('2d', { alpha: false });
				const buffer = document.createElement('canvas');
				const bufferContext = buffer.getContext('2d', { alpha: false });
				if (exitContext) {
					exitContext.fillStyle = '#fff';
					exitContext.fillRect(0, 0, width, height);
				}
				let exitCanvasAttached = false;
				const visibleMedia = [...(content?.querySelectorAll<HTMLImageElement | HTMLVideoElement>('img, video') ?? [])];
				const texts = [...document.querySelectorAll<HTMLElement>('[data-case-reveal]')].map((element) => ({
					element,
					characters: [...(element.dataset.value ?? '')],
					spans: [...element.querySelectorAll<HTMLElement>('span')],
					pool: [...new Set([...(element.dataset.value ?? '')].filter((character) => character !== ' '))],
				}));
				const startedAt = performance.now();
				let lastTextTick = 0;
				const duration = 960;
				const frame = (now: number) => {
					const progress = Math.min(1, (now - startedAt) / duration);
					const eased = progress * progress * (3 - 2 * progress);
					if (now - lastTextTick >= 44 || progress === 1) {
						lastTextTick = now;
						texts.forEach(({ characters, spans, pool }) => {
							const visible = Math.max(0, Math.ceil(characters.length * (1 - eased)));
							spans.forEach((span, index) => {
								if (index >= visible) span.textContent = '';
								else if (characters[index] === ' ') span.textContent = '\u00a0';
								else span.textContent = pool[Math.floor(Math.random() * pool.length)] ?? characters[index];
							});
						});
					}
					if (exitContext && bufferContext && viewport) {
						const pixelWidth = Math.max(5, Math.round(720 + (5 - 720) * eased));
						const pixelHeight = Math.max(1, Math.round(pixelWidth * height / width));
						buffer.width = pixelWidth;
						buffer.height = pixelHeight;
						bufferContext.fillStyle = '#fff';
						bufferContext.fillRect(0, 0, pixelWidth, pixelHeight);
						const viewportRect = viewport.getBoundingClientRect();
						visibleMedia.forEach((media) => {
							const sourceWidth = media instanceof HTMLVideoElement ? media.videoWidth : media.naturalWidth;
							const sourceHeight = media instanceof HTMLVideoElement ? media.videoHeight : media.naturalHeight;
							const ready = media instanceof HTMLVideoElement ? media.readyState >= 2 : media.complete;
							if (!ready || !sourceWidth || !sourceHeight) return;
							const rect = media.getBoundingClientRect();
							const top = Math.max(rect.top, viewportRect.top);
							const bottom = Math.min(rect.bottom, viewportRect.bottom);
							if (bottom <= top) return;
							const sourceY = (top - rect.top) / rect.height * sourceHeight;
							const visibleSourceHeight = (bottom - top) / rect.height * sourceHeight;
							bufferContext.drawImage(
								media, 0, sourceY, sourceWidth, visibleSourceHeight,
								0, (top - viewportRect.top) / height * pixelHeight,
								pixelWidth, (bottom - top) / height * pixelHeight,
							);
						});
						exitContext.imageSmoothingEnabled = false;
						exitContext.drawImage(buffer, 0, 0, pixelWidth, pixelHeight, 0, 0, width, height);
						const whiteout = Math.max(0, (progress - 0.76) / 0.24);
						exitContext.fillStyle = `rgb(255 255 255 / ${whiteout * whiteout})`;
						exitContext.fillRect(0, 0, width, height);
						if (!exitCanvasAttached) {
							exitCanvasAttached = true;
							document.body.append(exitCanvas);
						}
					}
					if (progress < 1) requestAnimationFrame(frame);
					else {
						resolve();
					}
				};
				requestAnimationFrame(frame);
			});
			closeLink?.addEventListener('click', async (event) => {
				if (mobileCase) {
					event.preventDefault();
					window.setTimeout(() => window.location.assign('/mobile'), 260);
					return;
				}
				event.preventDefault();
				await leaveCase();
				window.location.assign(`/?case-return=${Date.now()}`);
			});

			const browserNavigation = (window as typeof window & {
				navigation?: EventTarget;
			}).navigation;
			browserNavigation?.addEventListener('navigate', ((navigationEvent: Event & {
				navigationType?: string;
				canIntercept?: boolean;
				intercept?: (options: { handler: () => Promise<void> }) => void;
			}) => {
				if (
					mobileCase
					||
					navigationEvent.navigationType !== 'traverse'
					|| !navigationEvent.canIntercept
					|| !navigationEvent.intercept
					|| isLeaving
				) return;
				navigationEvent.intercept({ handler: leaveCase });
			}) as EventListener);
		</script>
	</body>
</html>

