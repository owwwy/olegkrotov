		isolation: isolate;
		will-change: clip-path;
	}

	.showcase__media::after {
		position: absolute;
		z-index: 2;
		inset: 0;
		background:
			linear-gradient(180deg, rgb(255 255 255 / 42%), transparent 18%, transparent 82%, rgb(0 0 0 / 10%)),
			radial-gradient(ellipse at center, transparent 48%, rgb(255 255 255 / 34%) 100%);
		content: '';
		opacity: var(--lens-light);
		pointer-events: none;
		transition: opacity 140ms ease-out;
	}

	.showcase__lens {
		position: absolute;
		z-index: 1;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		opacity: 0;
		pointer-events: none;
		transition: opacity 180ms ease;
	}

	.showcase__media.is-webgl .showcase__lens {
		opacity: 1;
	}

	.showcase__media.is-webgl .showcase__panel {
		opacity: 0;
	}

	.showcase__project-cta {
		position: relative;
