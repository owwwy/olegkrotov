		grid-row: 1;
		align-self: end;
		justify-self: center;
		margin-bottom: var(--project-cta-bottom);
		padding: var(--project-cta-padding-block) var(--project-cta-padding-inline);
		overflow: hidden;
		color: #fff;
		font-size: var(--ui-font-size);
		font-weight: 400;
		line-height: var(--ui-line-height);
		white-space: nowrap;
		background: linear-gradient(180deg, #232326 0%, #19191c 100%);
