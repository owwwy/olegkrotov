<script is:inline data-astro-rerun>
	(() => {
		const interpolate = (from, to, progress) => from + (to - from) * progress;
		const roundToEven = (value) => Math.round(value / 2) * 2;
		const scale = (width, compact, desktop, wide) => {
			if (width <= 1200) return compact;
			if (width < 1780) return interpolate(compact, desktop, (width - 1200) / 580);
			if (width <= 1920) return desktop;
			if (width < 2048) return interpolate(desktop, wide, (width - 1920) / 128);
			return wide;
		};

		const updateTypeScale = () => {
			const width = window.innerWidth;
			const ui = Math.round(scale(width, 16, 20, 28));
			const title = Math.round(scale(width, 80, 120, 160));
			const info = roundToEven(scale(width, 34, 48, 56));
			const infoLine = roundToEven(scale(width, 40, 58, 68));
			const infoGap = roundToEven(scale(width, 8, 12, 14));
			const infoParagraphGap = roundToEven(scale(width, 34, 48, 56));
			const infoChip = roundToEven(scale(width, 84, 120, 140));
			const infoChipLong = roundToEven(scale(width, 110, 156, 182));
			const infoChipHeight = roundToEven(scale(width, 40, 58, 68));
			const contactLetter = roundToEven(scale(width, 108, 160, 280));
			const root = document.documentElement;
			root.style.setProperty('--ui-font-size', `${ui}px`);
			root.style.setProperty('--ui-line-height', `${roundToEven(ui * 1.2)}px`);
			root.style.setProperty('--role-font-size', `${Math.round(ui * 0.8)}px`);
			root.style.setProperty('--project-title-size', `${title}px`);
			root.style.setProperty('--project-title-line-height', `${roundToEven(title)}px`);
			root.style.setProperty('--info-font-size', `${info}px`);
			root.style.setProperty('--info-line-height', `${infoLine}px`);
			root.style.setProperty('--info-inline-gap', `${infoGap}px`);
			root.style.setProperty('--info-paragraph-gap', `${infoParagraphGap}px`);
			root.style.setProperty('--info-chip-width', `${infoChip}px`);
			root.style.setProperty('--info-chip-long-width', `${infoChipLong}px`);
			root.style.setProperty('--info-chip-height', `${infoChipHeight}px`);
			root.style.setProperty('--contact-letter-size', `${contactLetter}px`);
		};

		updateTypeScale();
		if (!window.__olegTypeScaleBound) {
			window.__olegTypeScaleBound = true;
			window.addEventListener('resize', updateTypeScale, { passive: true });
		}
	})();
</script>
