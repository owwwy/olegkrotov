---
interface Props {
	href: string;
	label: string;
	active?: boolean;
}

const { href, label, active = false } = Astro.props;
---

<a
	class:list={['scramble-link', { 'is-active': active }]}
	href={href}
	aria-label={label}
	aria-current={active ? 'page' : undefined}
	data-scramble-link={active ? undefined : ''}
>
	<span class="scramble-link__text" aria-hidden="true" data-scramble-text data-original={label}>
		{[...label].map((character) => (
			<span class="scramble-link__char">{character === ' ' ? '\u00a0' : character}</span>
		))}
	</span>
</a>

<script>
	const DURATION = 260;
	const MIN_TICK = 38;
	const MAX_TICK = 76;
	const LOCKED_CHARACTERS = new Set([' ', '+', '(', ')', '-', '–', '—']);
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	const shuffle = (values: string[]) => {
		const result = [...values];

		for (let index = result.length - 1; index > 0; index -= 1) {
			const target = Math.floor(Math.random() * (index + 1));
			[result[index], result[target]] = [result[target], result[index]];
		}

		return result;
	};

	const render = (spans: HTMLElement[], characters: string[]) => {
		spans.forEach((span, index) => {
			span.textContent = characters[index] === ' ' ? '\u00a0' : characters[index];
		});
	};

	const animateText = (text: HTMLElement) => {
		if (text.dataset.animating === 'true' || reduceMotion.matches) return;

		const original = [...(text.dataset.original ?? '')];
		const spans = [...text.querySelectorAll<HTMLElement>('.scramble-link__char')];
		const mutableIndexes = original.flatMap((character, index) =>
			LOCKED_CHARACTERS.has(character) ? [] : [index],
		);
		const mutableCharacters = mutableIndexes.map((index) => original[index]);

		text.style.width = `${text.getBoundingClientRect().width}px`;
		text.dataset.animating = 'true';

		const startedAt = performance.now();
		let nextTick = startedAt;

		const frame = (now: number) => {
			const progress = Math.min(1, (now - startedAt) / DURATION);
			const eased = 1 - Math.pow(1 - progress, 3);

			if (now >= nextTick) {
				nextTick = now + MIN_TICK + (MAX_TICK - MIN_TICK) * eased;
				const scrambled = [...original];
				const shuffled = shuffle(mutableCharacters);
				mutableIndexes.forEach((characterIndex, index) => {
					scrambled[characterIndex] = shuffled[index];
				});
				render(spans, scrambled);
			}

			if (progress < 1) {
				requestAnimationFrame(frame);
				return;
			}

			render(spans, original);
			text.dataset.animating = 'false';
			text.style.removeProperty('width');
		};

		requestAnimationFrame(frame);
	};

	const animate = (link: HTMLElement) => {
		if (window.matchMedia('(max-width: 767px)').matches) return;
		link.querySelectorAll<HTMLElement>('[data-scramble-text]').forEach(animateText);
	};
	const buildText = (text: HTMLElement, delay: number) => {
		const original = [...(text.dataset.original ?? '')];
		const spans = [...text.querySelectorAll<HTMLElement>('.scramble-link__char')];
		const pool = original.filter((character) => !LOCKED_CHARACTERS.has(character));
		spans.forEach((span) => { span.textContent = ''; });
		window.setTimeout(() => {
			const startedAt = performance.now();
			const duration = Math.max(260, original.length * 48);
			const frame = (now: number) => {
				const progress = Math.min(1, (now - startedAt) / duration);
				const visible = Math.ceil(progress * original.length);
				const settled = Math.max(0, visible - 2);
				spans.forEach((span, index) => {
					if (index >= visible) span.textContent = '';
					else if (original[index] === ' ') span.textContent = '\u00a0';
					else span.textContent = index < settled
						? original[index]
						: pool[Math.floor(Math.random() * pool.length)] ?? original[index];
				});
				if (progress < 1) requestAnimationFrame(frame);
				else render(spans, original);
			};
			requestAnimationFrame(frame);
		}, delay);
	};

	document.querySelectorAll<HTMLElement>('[data-scramble-link]').forEach((link) => {
		if (link.dataset.scrambleBound === 'true') return;
		link.dataset.scrambleBound = 'true';
		link.addEventListener('pointerenter', () => animate(link));
		link.addEventListener('focus', () => animate(link));
	});

	if (document.documentElement.classList.contains('is-preloading')) {
		const menuTexts = [...document.querySelectorAll<HTMLElement>('nav [data-scramble-text]')];
		menuTexts.forEach((text) => {
			text.querySelectorAll<HTMLElement>('.scramble-link__char').forEach((span) => { span.textContent = ''; });
		});
		window.addEventListener('site:reveal', () => {
			menuTexts.forEach((text, index) => buildText(text, index * 150));
		}, { once: true });
	}
</script>

<style>
	.scramble-link {
		display: inline-flex;
		padding-block: 12px;
	}

	.scramble-link__text {
		display: inline-block;
	}

	.scramble-link__char {
		display: inline-block;
	}

	.scramble-link.is-active {
		opacity: 0.6;
		pointer-events: none;
	}

	.scramble-link:focus-visible {
		outline: none;
	}

</style>
