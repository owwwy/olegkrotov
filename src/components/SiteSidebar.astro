---
import ScrambleLink from './ScrambleLink.astro';

interface Props {
	active: 'projects' | 'info' | 'contacts';
}

const { active } = Astro.props;
const navigation = [
	{ id: 'projects', label: 'Проекты', href: '/' },
	{ id: 'info', label: 'Инфо', href: '/info' },
	{ id: 'contacts', label: 'Контакты', href: '/#contacts' },
] as const;
---

<aside class="sidebar" transition:persist="site-sidebar">
	<a class="identity" href="/" aria-label="Олег Кротов — на главную" data-scramble-link>
		<strong data-scramble-text data-original="Олег Кротов">
			{[...'Олег Кротов'].map((character) => (
				<span class="scramble-link__char">{character === ' ' ? '\u00a0' : character}</span>
			))}
		</strong>
		<span data-scramble-text data-original="Digital Designer">
			{[...'Digital Designer'].map((character) => (
				<span class="scramble-link__char">{character === ' ' ? '\u00a0' : character}</span>
			))}
		</span>
	</a>

	<nav aria-label="Основная навигация" data-mobile-label="Меню">
		{navigation.map((item, index) => (
			<>
				<ScrambleLink href={item.href} label={item.label} active={item.id === active} />
				{index < navigation.length - 1 && <span class="nav-separator" aria-hidden="true">·</span>}
			</>
		))}
	</nav>
</aside>

<style is:global>
	.sidebar {
		position: sticky;
		top: 0;
		display: flex;
		grid-column: 1 / span 3;
		flex-direction: column;
		justify-content: space-between;
		height: 100svh;
		padding-block: var(--page-padding);
	}

	.sidebar .identity {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
	}

	.sidebar .identity strong {
		font-size: var(--ui-font-size);
		font-weight: 400;
		line-height: var(--ui-line-height);
	}

	.sidebar .identity > span {
		color: rgb(25 25 28 / 60%);
		font-size: var(--role-font-size);
		font-weight: 300;
		line-height: var(--ui-line-height);
	}

	.sidebar .identity [data-scramble-text],
	.sidebar .identity .scramble-link__char {
		display: inline-block;
	}

	.sidebar nav {
		display: flex;
		align-items: center;
		font-size: var(--ui-font-size);
		font-weight: 400;
		line-height: var(--ui-line-height);
		white-space: nowrap;
	}

	.sidebar .nav-separator {
		margin-inline: 0.4em;
		flex: none;
		color: currentColor;
	}

	@media (max-width: 767px) {
		.sidebar {
			position: sticky;
			z-index: 20;
			top: 0;
			display: flex;
			align-items: flex-start;
			width: 100%;
			height: auto;
			padding: 16px;
			flex-direction: row;
			justify-content: space-between;
			background: #fff;
		}

		.sidebar .identity strong,
		.sidebar nav {
			font-size: 18px;
			font-weight: 400;
			line-height: 24px;
		}

		.sidebar .identity > span,
		.sidebar nav > * {
			display: none;
		}

		.sidebar nav::before {
			display: block;
			content: attr(data-mobile-label);
		}
	}
</style>

<script>
	const setActiveSidebarLink = (activeLink: HTMLAnchorElement) => {
		document.querySelectorAll<HTMLAnchorElement>('.sidebar nav a').forEach((link) => {
			const active = link === activeLink;
			link.classList.toggle('is-active', active);
			if (active) link.setAttribute('aria-current', 'page');
			else link.removeAttribute('aria-current');
		});
	};

	const updateSidebarState = () => {
		const normalizePathname = (pathname: string) => pathname === '/'
			? '/'
			: pathname.replace(/\/+$/, '');
		const pathname = normalizePathname(window.location.pathname);
		const hash = window.location.hash;
		document.querySelectorAll<HTMLAnchorElement>('.sidebar nav a').forEach((link) => {
			const target = new URL(link.href, window.location.href);
			const active = normalizePathname(target.pathname) === pathname
				&& (target.hash ? target.hash === hash : !hash);
			link.classList.toggle('is-active', active);
			if (active) link.setAttribute('aria-current', 'page');
			else link.removeAttribute('aria-current');
		});
	};

	const bindSidebarNavigation = () => {
		const navigation = document.querySelector<HTMLElement>('.sidebar nav');
		if (!navigation || navigation.dataset.activeStateBound === 'true') return;
		navigation.dataset.activeStateBound = 'true';
		navigation.addEventListener('click', (event) => {
			const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a');
			if (link) setActiveSidebarLink(link);
		});
	};

	document.addEventListener('astro:page-load', updateSidebarState);
	document.addEventListener('astro:page-load', bindSidebarNavigation);
</script>
